//// validation — what the decorators refuse, and where.
////
//// A refusal is a program that does not compile, so it cannot be a case of a
//// module that has to compile. Each case here writes a one-file project into
//// the run's scratch directory (`BOTOPINK_TEST_TMPDIR`), runs `botopink check`
//// over it, and reads the diagnostic: the exit status, the message, and the
//// location (decision 67 — a refusal is located, never a warning).

import {decorators.markerNames};
import {io.fs, io.process, io.env, path, json} from "std";

// The run's own scratch directory — `botopink test` names it, and it is the
// one place a test writes.
fn testTmp() -> string {
    val root = env.read("BOTOPINK_TEST_TMPDIR") ?? "";
    assert root != "", "BOTOPINK_TEST_TMPDIR is not set";
    return root;
}

// The compiler the fixtures are checked with: `BOTOPINK_BIN` when the caller
// names one, else the meta checkout's compiler — this package sits at
// `repository/validation`, beside `repository/botopink-lang` — else the
// compiler of a CI checkout that placed it at `botopink-lang/repository/validation`.
fn botopinkBin() -> string {
    val named = env.read("BOTOPINK_BIN") ?? "";
    if (named != "" && fs.exists(named)) return named;
    val sibling = path.normalize(
        path.join(
            [
                process.cwd(),
                "..",
                "botopink-lang",
                "zig-out",
                "bin",
                "botopink",
            ],
        ),
    );
    if (fs.exists(sibling)) return sibling;
    return path.normalize(
        path.join([process.cwd(), "..", "..", "zig-out", "bin", "botopink"]),
    );
}

// A fixture's manifest: its `files`, and `validation` — this package's own
// directory — declared in `dependencies`, as any program that imports it must
// (decision 242).
fn fixtureManifest(files: string) -> string {
    return [
        """{ "name": "fixture", "version": "0.0.1", "src": "src/", "entry": "main.bp", "target": "erlang", "files": [""",
        files,
        """], "dependencies": { "validation": { "path": """,
        json.quote(process.cwd()),
        " } } }",
    ].join("");
}

val MAIN_ONLY = "\"main.bp\"";

// `botopink check` over a project whose `src/main.bp` is `source`: its status
// and its output, stdout and stderr together, as `<status>\n<output>`.
fn checked(name: string, source: string) -> string {
    val dir = path.join([testTmp(), "refusal", name]);
    val made = process.run("mkdir", ["-p", path.join([dir, "src"])]);
    assert made.isOk();
    val m = fs.writeText(
        path.join([dir, "botopink.json"]),
        fixtureManifest(MAIN_ONLY),
    );
    assert m.isOk();
    val s = fs.writeText(path.join([dir, "src", "main.bp"]), source);
    assert s.isOk();
    val r = process.run(
        "sh",
        ["-c", "cd \"$0\" && \"$1\" check . 2>&1", dir, botopinkBin()],
    );
    return case r {
        Ok(e) -> [[e.status].join(""), e.stdout].join("\n");
        Error(why) -> ["-1", why].join("\n");
    };
}

fn refusedWith(out: string, text: string, at: string) -> bool {
    return out.startsWith("1\n")
        && out.indexOf(text) >= 0
        && out.indexOf(["--> src/main.bp:", at].join("")) >= 0;
}

val SCHEMA_IMPORTS = """import {decorators.schema} from "validation";
import {schemas, schemas.Schema, report.ValidationReport, report.Violation} from "validation";
import {json.Json} from "std";
""";

// ── `#[schema]` ─────────────────────────────────────────────────────────────

test "validation: a field type #[schema] does not decode is refused, naming field and type" {
    val out = checked(
        "schema_unsupported_field",
        [
            SCHEMA_IMPORTS,
            """import {collections.Queue} from "std";

#[schema]
pub type Bad(
    name: string,
    scores: Queue<i32>,
)
""",
        ].join(""),
    );
    assert refusedWith(
        out,
        "#[schema] on `Bad`: field `scores` is `Queue<i32>`, which this decorator does not decode",
        "6:3",
    );
}

test "validation: the same project with a decoded field type compiles" {
    val out = checked(
        "schema_supported_field",
        [
            SCHEMA_IMPORTS,
            """
#[schema]
pub type Good(
    name: string,
    scores: Array<i32>,
)
""",
        ].join(""),
    );
    assert out.startsWith("0\n");
}

test "validation: #[exhaustive] on a dict whose key is not a #[schema] enum is refused" {
    val out = checked(
        "schema_exhaustive_text_key",
        [
            SCHEMA_IMPORTS,
            """import {decorators.exhaustive} from "validation";
import {collections.Dict} from "std";

#[schema]
pub type Bad(
    #[exhaustive] labels: Dict<string, string>,
)
""",
        ].join(""),
    );
    assert refusedWith(
        out,
        "#[exhaustive] on field `labels` of `Bad`: it applies to `Dict<K, V>` whose key `K` is a #[schema] enum",
        "7:3",
    );
}

test "validation: #[tag] on a record is refused" {
    val out = checked(
        "schema_tag_on_record",
        [
            SCHEMA_IMPORTS,
            """import {decorators.tag} from "validation";

#[schema]
#[tag("kind")]
pub type Bad(name: string)
""",
        ].join(""),
    );
    assert refusedWith(
        out,
        "#[tag] on `Bad`: a tag names the variant of an enum, and this type is a record",
        "6:3",
    );
}

// ── step 5: object policy ───────────────────────────────────────────────────

val POLICY_IMPORTS = """import {decorators.orElse, decorators.present, decorators.rest, decorators.stripUnknown} from "validation";
import {collections.Dict} from "std";
""";

test "validation: #[orElse] with a literal that is not the field's type is refused" {
    val out = checked(
        "schema_or_else_mismatch",
        [
            SCHEMA_IMPORTS,
            POLICY_IMPORTS,
            """
#[schema]
pub type Bad(
    #[orElse(7)] food: string,
)
""",
        ].join(""),
    );
    assert refusedWith(
        out,
        "#[orElse] on field `food` of `Bad`: the literal `7` is not a `string`",
        "7:3",
    );
}

test "validation: #[present] on a field that is not optional is refused" {
    val out = checked(
        "schema_present_required",
        [
            SCHEMA_IMPORTS,
            POLICY_IMPORTS,
            """
#[schema]
pub type Bad(
    #[present] middle: string,
)
""",
        ].join(""),
    );
    assert refusedWith(
        out,
        "#[schema] on field `middle` of `Bad`: #[present] says the key may be left out, so the field is `?T`, and this one is `string`",
        "7:3",
    );
}

test "validation: #[rest] on a field that is not Dict<string, T> is refused, and so is a second one" {
    val wrongType = checked(
        "schema_rest_type",
        [
            SCHEMA_IMPORTS,
            POLICY_IMPORTS,
            """
#[schema]
pub type Bad(
    #[rest] extra: Array<string>,
)
""",
        ].join(""),
    );
    assert refusedWith(
        wrongType,
        "#[rest] holds the members the type does not declare, so the field is `Dict<string, T>`, and this one is `Array<string>`",
        "7:3",
    );
    val two = checked(
        "schema_rest_twice",
        [
            SCHEMA_IMPORTS,
            POLICY_IMPORTS,
            """
#[schema]
#[stripUnknown]
pub type Bad(
    #[rest] a: Dict<string, i32>,
)
""",
        ].join(""),
    );
    assert refusedWith(
        two,
        "#[stripUnknown] on `Bad`: a #[rest] field keeps the undeclared members, so they cannot also be dropped",
        "7:3",
    );
}

// ── step 6: coercion and transforms ─────────────────────────────────────────

test "validation: #[coerce] on a type it cannot read from text, and a transform on a non-text field, are refused" {
    val coerced = checked(
        "schema_coerce_list",
        [
            SCHEMA_IMPORTS,
            """import {decorators.coerce, decorators.trim} from "validation";

#[schema]
pub type Bad(
    #[coerce] ids: Array<i32>,
)
""",
        ].join(""),
    );
    assert refusedWith(
        coerced,
        "#[schema] on field `ids` of `Bad`: #[coerce] reads text as `string`, `i32`, `i64`, `f64` or `bool` (or their `?T`), and this field is `Array<i32>`",
        "6:3",
    );
    val trimmed = checked(
        "schema_trim_number",
        [
            SCHEMA_IMPORTS,
            """import {decorators.coerce, decorators.trim} from "validation";

#[schema]
pub type Bad(
    #[trim] n: i32,
)
""",
        ].join(""),
    );
    assert refusedWith(
        trimmed,
        "#[schema] on field `n` of `Bad`: a transform rewrites text, and this field is `i32`",
        "6:3",
    );
}

test "validation: a decoding marker on a #[validated] type that is not #[schema] is refused" {
    val out = checked(
        "validated_coerce_without_schema",
        """import {decorators.validated, decorators.coerce} from "validation";
import {report.ValidationReport, report.Violation, table.constraintTableJson} from "validation";

#[validated]
pub type Bad(
    #[coerce] age: i32,
)
""",
    );
    assert refusedWith(
        out,
        "#[coerce] on field `age` of `Bad`: it says how a document is decoded, and `Bad` is not #[schema] - nothing would read it",
        "4:3",
    );
}

// ── step 7: messages ────────────────────────────────────────────────────────

test "validation: #[message] with no marker before it, and #[stopOnFirst] over one check, are refused" {
    val lone = checked(
        "validated_message_alone",
        """import {decorators.validated, decorators.message, decorators.notBlank} from "validation";
import {report.ValidationReport, report.Violation, table.constraintTableJson} from "validation";

#[validated]
pub type Bad(
    #[message("x")] #[notBlank] name: string,
)
""",
    );
    assert refusedWith(
        lone,
        "#[message] on field `name` of `Bad`: it restates the marker before it, and none comes before it",
        "4:3",
    );
    val single = checked(
        "validated_stop_on_first_single",
        """import {decorators.validated, decorators.stopOnFirst, decorators.notBlank} from "validation";
import {report.ValidationReport, report.Violation, table.constraintTableJson} from "validation";

#[validated]
pub type Bad(
    #[stopOnFirst] #[notBlank] name: string,
)
""",
    );
    assert refusedWith(
        single,
        "#[stopOnFirst] on field `name` of `Bad`: it skips the checks after the first failure, and this field has fewer than two",
        "4:3",
    );
}

// ── every marker on a field type it cannot check ────────────────────────────
//
// One row per marker of `decorators.markerNames()`: the marker, its arguments
// as written, and a field type it does not check. The fixture is one project
// with a module per row, checked once; each module's refusal is asserted by
// its message and its location. A marker added without a row fails the count.

fn markerRows() -> Array<#(string, string, string)> {
    return [
        #("notNull", "", "string"),
        #("notBlank", "", "i32"),
        #("notEmpty", "", "bool"),
        #("sizeBetween", "(1, 2)", "bool"),
        #("minValue", "(1)", "string"),
        #("maxValue", "(1)", "string"),
        #("positive", "", "string"),
        #("positiveOrZero", "", "string"),
        #("email", "", "i32"),
        #("pattern", "(\"^a$\")", "i32"),
        #("pastDate", "", "string"),
        #("futureDate", "", "string"),
        #("constraint", "(\"x\")", "i32"),
        #("minLength", "(1)", "bool"),
        #("maxLength", "(1)", "bool"),
        #("length", "(1)", "bool"),
        #("startsWith", "(\"a\")", "i32"),
        #("endsWith", "(\"a\")", "i32"),
        #("includes", "(\"a\")", "i32"),
        #("uppercase", "", "i32"),
        #("lowercase", "", "i32"),
        #("emailHtml5", "", "i32"),
        #("emailRfc5322", "", "i32"),
        #("emailUnicode", "", "i32"),
        #("uuid", "", "i32"),
        #("uuidV", "(4)", "i32"),
        #("guid", "", "i32"),
        #("url", "", "i32"),
        #("urlHost", "(\"^a$\")", "i32"),
        #("urlProtocol", "(\"^https$\")", "i32"),
        #("httpUrl", "", "i32"),
        #("hostname", "", "i32"),
        #("e164", "", "i32"),
        #("emoji", "", "i32"),
        #("base64", "", "i32"),
        #("base64url", "", "i32"),
        #("hex", "", "i32"),
        #("jwt", "", "i32"),
        #("jwtAlg", "(\"HS256\")", "i32"),
        #("nanoid", "", "i32"),
        #("cuid", "", "i32"),
        #("cuid2", "", "i32"),
        #("ulid", "", "i32"),
        #("ipv4", "", "i32"),
        #("ipv6", "", "i32"),
        #("mac", "", "i32"),
        #("macDelimiter", "(\"-\")", "i32"),
        #("cidrv4", "", "i32"),
        #("cidrv6", "", "i32"),
        #("creditCard", "", "i32"),
        #("currencyCode", "", "i32"),
        #("iban", "", "i32"),
        #("hash", "(\"sha256\")", "i32"),
        #("hashEnc", "(\"sha256\", \"hex\")", "i32"),
        #("isoDate", "", "i32"),
        #("isoTime", "", "i32"),
        #("isoTimePrecision", "(3)", "i32"),
        #("isoDatetime", "", "i32"),
        #("isoDatetimeOffset", "", "i32"),
        #("isoDatetimeLocal", "", "i32"),
        #("isoDatetimePrecision", "(3)", "i32"),
        #("isoDuration", "", "i32"),
        #("gt", "(1)", "string"),
        #("lt", "(1)", "string"),
        #("negative", "", "string"),
        #("negativeOrZero", "", "string"),
        #("multipleOf", "(5)", "string"),
        #("safeInt", "", "i32"),
        #("float32", "", "i32"),
        #("afterIso", "(\"2020-01-01T00:00:00Z\")", "i32"),
        #("beforeIso", "(\"2020-01-01T00:00:00Z\")", "i32"),
        #("literal", "(\"kg\")", "f64"),
        #("oneOf", "(\"a,b\")", "i32"),
    ];
}

fn rowModule(row: #(string, string, string)) -> string {
    return [
        "import {decorators.validated, decorators.",
        row._0,
        "} from \"validation\";\nimport {report.ValidationReport, report.Violation, table.constraintTableJson} from \"validation\";\n\n#[validated]\npub type Bad(#[",
        row._0,
        row._1,
        "] x: ",
        row._2,
        ")\n",
    ].join("");
}

// `botopink check` over a project of one module per row (`m_<marker>.bp`) and
// a `main.bp` naming them all.
fn checkedMarkers(
    fixture: string,
    rows: Array<#(string, string, string)>,
) -> string {
    val dir = path.join([testTmp(), "refusal", fixture]);
    val made = process.run("mkdir", ["-p", path.join([dir, "src"])]);
    assert made.isOk();
    var names: Array<string> = [];
    var k = 0;
    while (k < rows.length) {
        names = names.append([["m_", [k].join("")].join("")]);
        k = k + 1;
    }
    val files = names.map({ n -> ["\"", n, ".bp\""].join("") });
    val manifest = fixtureManifest([files.join(", "), MAIN_ONLY].join(", "));
    val m = fs.writeText(path.join([dir, "botopink.json"]), manifest);
    assert m.isOk();
    val main = names.map({ n -> ["pub mod ", n, ";"].join("") }).join("\n");
    val w = fs.writeText(
        path.join([dir, "src", "main.bp"]),
        [main, "\n"].join(""),
    );
    assert w.isOk();
    var i = 0;
    while (i < rows.length) {
        val row = rows.at(i) ?? #("", "", "");
        val written = fs.writeText(
            path.join([dir, "src", ["m_", [i].join(""), ".bp"].join("")]),
            rowModule(row),
        );
        assert written.isOk();
        i = i + 1;
    }
    val r = process.run(
        "sh",
        ["-c", "cd \"$0\" && \"$1\" check . 2>&1", dir, botopinkBin()],
    );
    return case r {
        Ok(e) -> [[e.status].join(""), e.stdout].join("\n");
        Error(why) -> ["-1", why].join("\n");
    };
}

test "validation: every marker has a refusal row" {
    val rows = markerRows();
    assert rows.length == markerNames().length;
    val listed = rows.map({ r -> r._0 }).join("|");
    assert listed == markerNames().join("|");
}

test "validation: every marker on a field type it cannot check is a located compile error" {
    val rows = markerRows();
    val out = checkedMarkers("types", rows);
    assert out.startsWith("1\n");
    var missing: Array<string> = [];
    var i = 0;
    while (i < rows.length) {
        val r = rows.at(i) ?? #("", "", "");
        val text = ["#[", r._0, "] on field `x` of `Bad`: "].join("");
        val at = ["--> src/m_", [i].join(""), ".bp:4:3"].join("");
        if (out.indexOf(text) < 0 || out.indexOf(at) < 0)
            missing = missing.append([r._0]);
        i = i + 1;
    }
    assert missing.join(",") == "";
}

// Arguments a marker refuses, and an optional field type no marker reads
// through: `#(marker, arguments, field type)`, and beside it the message.
fn argumentRows() -> Array<#(string, string, string)> {
    return [
        #("minLength", "(0)", "string"),
        #("maxLength", "(-1)", "string"),
        #("startsWith", "(\"\")", "string"),
        #("includes", "(\"a|b\")", "string"),
        #("uuidV", "(9)", "string"),
        #("macDelimiter", "(\"a\")", "string"),
        #("hash", "(\"sha3\")", "string"),
        #("hashEnc", "(\"sha256\", \"hex64\")", "string"),
        #("isoTimePrecision", "(10)", "string"),
        #("isoDatetimePrecision", "(3)", "string"),
        #("gt", "(0.5)", "i32"),
        #("multipleOf", "(0)", "i32"),
        #("multipleOf", "(1e-3)", "f64"),
        #("afterIso", "(\"2020-01-01\")", "i64"),
        #("minLength", "(1)", "?Array<string>"),
        #("oneOf", "(\"a\")", "string"),
        #("oneOf", "(\"a,,b\")", "string"),
        #("literal", "(1.5)", "i32"),
    ];
}

fn argumentMessages() -> Array<string> {
    return [
        "#[minLength]: a lower bound below 1 could never fail",
        "#[maxLength]: the upper bound may not be negative",
        "#[startsWith]: the prefix may not be empty",
        "#[includes]: the substring may not contain ';' or '|'",
        "#[uuidV]: RFC 9562 versions are 1 to 8",
        "#[macDelimiter]: the delimiter is one character that is not a hex digit",
        "#[hash]: the algorithm is one of md5, sha1, sha256, sha384, sha512",
        "#[hashEnc]: the encoding is one of hex, base64, base64url",
        "#[isoTimePrecision]: the precision is -1 (minutes), 0 (seconds) or 1 to 9 fraction digits",
        "#[isoDatetimePrecision] on field `x` of `Bad`: it fixes the precision only",
        "#[gt] on field `x` of `Bad`: the bound `0.5` is not a whole number",
        "#[multipleOf]: the step must be greater than 0",
        "#[multipleOf] on field `x` of `Bad`: write the step as a decimal",
        "#[afterIso]: the bound is an ISO datetime with its zone",
        "#[minLength] on field `x` of `Bad`: a marker on an optional field applies to",
        "#[oneOf]: one option is a #[literal]",
        "#[oneOf]: an option may not be empty",
        "#[literal] on field `x` of `Bad`: the literal `1.5` is not an `i32`",
    ];
}

test "validation: an argument a marker refuses is a compile error naming the rule" {
    val rows = argumentRows();
    val texts = argumentMessages();
    assert rows.length == texts.length;
    val out = checkedMarkers("arguments", rows);
    assert out.startsWith("1\n");
    var missing: Array<string> = [];
    var i = 0;
    while (i < texts.length) {
        val text = texts.at(i) ?? "";
        val at = ["--> src/m_", [i].join(""), ".bp:"].join("");
        if (out.indexOf(text) < 0 || out.indexOf(at) < 0)
            missing = missing.append([text]);
        i = i + 1;
    }
    assert missing.join(" / ") == "";
}
