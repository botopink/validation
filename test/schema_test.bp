//// validation — the parse half of `#[validated]`: from a document to a record.
////
//// The cases are the ones a decoder is easy to get wrong in silence: every
//// wrong field reported and not the first, the path of a value inside a list
//// inside a record, an absent key against an explicit `null`, a whole number
//// against a fraction, a key nobody declared, and a type that names itself.
////
//// Every expected text is a literal, and every case runs on both targets from
//// this one file. A decoder that answered differently on one of them would red
//// its own half here; `parity_test.bp` holds the two to one digest besides.

import {decorators.validated, decorators.notBlank, decorators.minValue, decorators.maxValue};
import {decorators.email, decorators.transparent, constraints.vEmail};
import {decorators.orElse, decorators.orElseOf, decorators.fallback, decorators.fallbackOf, decorators.present, decorators.rest};
import {constraints.vNotBlank, constraints.vMinValueI32, constraints.vMaxValueI32};
import {table.constraintTableJson};
import {derived};
import {report.ValidationReport, report.Violation};
import {messages.setMessageSource, messages.builtInOnly};
import {json, json.Json, collections.Set, collections.Dict, querystring} from "std";

// The types here are named apart from the examples' (`SignupDoc`, not
// `Signup`).
// LANGUAGE GAP: under `botopink test --target erlang`, two test modules that
// declare a type of one name share its module, so a member of one is reached
// from the other.
#[validated]
pub type SignupDoc(
    username: string,
    xp: i32,
    bio: ?string,
)

#[validated]
pub type AddressDoc(
    street: string,
    zip: string,
)

#[validated]
pub type LineDoc(
    sku: string,
    quantity: i32,
)

#[validated]
pub type OrderDoc(
    id: string,
    ship: AddressDoc,
    billing: ?AddressDoc,
    lines: Array<LineDoc>,
    tags: string[],
    note: ?string,
)

#[validated]
pub type CategoryDoc(
    name: string,
    subcategories: Array<CategoryDoc>,
)

#[validated]
pub type Numbers(
    small: i32,
    big: i64,
    ratio: f64,
    on: bool,
    extra: Json,
    grid: Array<Array<i32>>,
    maybe: ?Array<string>,
)

#[validated]
pub type Member(
    #[notBlank] name: string,
    #[minValue(18)] age: i32,
)

#[validated]
pub type Team(
    lead: Member,
    members: Array<Member>,
)

fn teamCodes(r: @Result<Team, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

fn fresh() -> i32 {
    return setMessageSource(builtInOnly());
}

fn signupCodes(r: @Result<SignupDoc, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

fn orderCodes(r: @Result<OrderDoc, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

fn numberCodes(r: @Result<Numbers, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
}

fn signupMessages(r: @Result<SignupDoc, ValidationReport>) -> string {
    return case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ": " + v.message })
            .join(" | ");
    };
}

// ── a flat record ───────────────────────────────────────────────────────────

test "validation: a well-formed document becomes a typed record" {
    val _f = fresh();
    val signup = try SignupDoc.decode("""{"username": "billie", "xp": 100}""");
    assert signup.username == "billie";
    assert signup.xp == 100;
    assert signup.bio == null;
}

test "validation: every wrong field is reported, in declaration order" {
    val _f = fresh();
    val r = SignupDoc.decode("""{"username": 42, "xp": "100", "bio": 7}""");
    assert signupCodes(r)
        == "username:invalidType,xp:invalidType,bio:invalidType";
}

test "validation: the message names what was expected and what arrived" {
    val _f = fresh();
    val r = SignupDoc.decode("""{"username": 42, "xp": "100"}""");
    assert signupMessages(r)
        == "username: must be text, was a number | xp: must be a whole number, was text";
}

test "validation: a missing key is required; a missing optional key is null" {
    val _f = fresh();
    assert signupCodes(SignupDoc.decode("""{"xp": 1}"""))
        == "username:required";
    assert signupCodes(SignupDoc.decode("""{"username": null, "xp": 1}"""))
        == "username:required";
    val explicit = try SignupDoc.decode(
        """{"username": "a", "xp": 1, "bio": null}""",
    );
    assert explicit.bio == null;
}

test "validation: an i32 refuses a fraction and a value outside its range" {
    val _f = fresh();
    assert signupCodes(SignupDoc.decode("""{"username": "a", "xp": 1.5}"""))
        == "xp:invalidType";
    assert signupCodes(
        SignupDoc.decode("""{"username": "a", "xp": 3000000000}"""),
    )
        == "xp:invalidType";
    val whole = try SignupDoc.decode("""{"username": "a", "xp": 7.0}""");
    assert whole.xp == 7;
    val negative = try SignupDoc.decode(
        """{"username": "a", "xp": -2147483648}""",
    );
    assert negative.xp < 0;
}

test "validation: a key the record does not declare is refused" {
    val _f = fresh();
    val r = SignupDoc.decode(
        """{"username": "a", "xp": 1, "admin": true, "role": "x"}""",
    );
    assert signupCodes(r) == "admin:unrecognizedKey,role:unrecognizedKey";
    assert signupMessages(r)
        == "admin: admin is not a field of SignupDoc | role: role is not a field of SignupDoc";
}

test "validation: a document that is not an object is one violation at the root" {
    val _f = fresh();
    assert signupCodes(SignupDoc.decode("[1]")) == ":invalidType";
    assert signupCodes(SignupDoc.decode("null")) == ":required";
}

test "validation: text that is not JSON is one violation, coded invalidJson" {
    val _f = fresh();
    assert signupCodes(SignupDoc.decode("{nope")) == ":invalidJson";
}

test "validation: parse reads a document already decoded" {
    val _f = fresh();
    val doc = try json.decode("""{"username": "billie", "xp": 3}""");
    val signup = try SignupDoc.parse(doc);
    assert signup.xp == 3;
}

// ── nesting ─────────────────────────────────────────────────────────────────

test "validation: a nested document becomes nested records" {
    val _f = fresh();
    val order = try OrderDoc.decode(
        """{"id": "o1", "ship": {"street": "Rua A", "zip": "01310-100"},
            "lines": [{"sku": "x", "quantity": 2}], "tags": ["a", "b"]}""",
    );
    assert order.ship.zip == "01310-100";
    assert order.lines.length == 1;
    assert order.tags.join(",") == "a,b";
    assert order.billing == null;
    assert order.note == null;
}

test "validation: a violation names the path to the value" {
    val _f = fresh();
    val r = OrderDoc.decode(
        """{"id": "o1", "ship": {"street": "Rua A"},
            "lines": [{"sku": "x", "quantity": 2}, {"sku": 7, "quantity": "two"}],
            "tags": ["a", 1]}""",
    );
    assert orderCodes(r)
        == "ship.zip:required,lines[1].sku:invalidType,lines[1].quantity:invalidType,tags[1]:invalidType";
}

test "validation: an optional record is null when absent and decoded when present" {
    val _f = fresh();
    val r = OrderDoc.decode(
        """{"id": "o1", "ship": {"street": "a", "zip": "b"}, "billing": {"street": 1},
            "lines": [], "tags": []}""",
    );
    assert orderCodes(r) == "billing.street:invalidType,billing.zip:required";
}

test "validation: an unknown key inside a nested record carries its path" {
    val _f = fresh();
    val r = OrderDoc.decode(
        """{"id": "o1", "ship": {"street": "a", "zip": "b", "country": "BR"},
            "lines": [{"sku": "x", "quantity": 1, "gift": true}], "tags": []}""",
    );
    assert orderCodes(r)
        == "ship.country:unrecognizedKey,lines[0].gift:unrecognizedKey";
}

test "validation: a list field refuses a value that is not a list" {
    val _f = fresh();
    val r = OrderDoc.decode(
        """{"id": "o1", "ship": {"street": "a", "zip": "b"}, "lines": {}, "tags": "a"}""",
    );
    assert orderCodes(r) == "lines:invalidType,tags:invalidType";
}

test "validation: a type that names itself decodes to any depth" {
    val _f = fresh();
    val tree = try CategoryDoc.decode(
        """{"name": "root", "subcategories": [
              {"name": "a", "subcategories": [{"name": "a1", "subcategories": []}]},
              {"name": "b", "subcategories": []}]}""",
    );
    assert tree.subcategories.length == 2;
    val first = tree.subcategories.at(0) ?? tree;
    assert first.name == "a";
    assert first.subcategories.length == 1;
}

fn depthOf(c: CategoryDoc) -> i32 {
    var depth = 1;
    var at = c;
    while (at.subcategories.length > 0) {
        at = at.subcategories.at(0) ?? at;
        depth = depth + 1;
    }
    return depth;
}

test "validation: a four-level recursive document decodes, a bad leaf at its path" {
    val _f = fresh();
    val tree = try CategoryDoc.decode(
        """{"name": "1", "subcategories": [{"name": "2", "subcategories": [
              {"name": "3", "subcategories": [{"name": "4", "subcategories": []}]}]}]}""",
    );
    assert depthOf(tree) == 4;
    val r = CategoryDoc.decode(
        """{"name": "1", "subcategories": [{"name": "2", "subcategories": [
              {"name": "3", "subcategories": [{"name": 4, "subcategories": []}]}]}]}""",
    );
    val located = case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
    assert located
        == "subcategories[0].subcategories[0].subcategories[0].name:invalidType";
}

// The decoder recurses through `Arr` once per level, so the depth it reaches
// is the document's. 2 000 levels is the depth these tests pin on both
// targets, over a document built as a value and over the same document read
// from its JSON text by std's reader.
fn nestedDocument(levels: i32) -> Json {
    var doc = Json.Obj(
        members: [
            #("name", Json.Str(value: "leaf")),
            #("subcategories", Json.Arr(items: [])),
        ],
    );
    var i = 1;
    while (i < levels) {
        doc = Json.Obj(
            members: [
                #("name", Json.Str(value: "n")),
                #("subcategories", Json.Arr(items: [doc])),
            ],
        );
        i = i + 1;
    }
    return doc;
}

test "validation: a self-reference 2000 levels deep does not exhaust the stack" {
    val _f = fresh();
    val tree = try CategoryDoc.parse(nestedDocument(2000));
    assert depthOf(tree) == 2000;
}

// The text of `nestedDocument(levels)`.
fn nestedText(levels: i32) -> string {
    var parts: string[] = [];
    var i = 1;
    while (i < levels) {
        parts.push("{\"name\":\"n\",\"subcategories\":[");
        i = i + 1;
    }
    parts.push("{\"name\":\"leaf\",\"subcategories\":[]}");
    i = 1;
    while (i < levels) {
        parts.push("]}");
        i = i + 1;
    }
    return parts.join("");
}

test "validation: a self-reference 2000 levels deep read from JSON text" {
    val _f = fresh();
    val tree = try CategoryDoc.decode(nestedText(2000));
    assert depthOf(tree) == 2000;
}

// ── the other primitives ────────────────────────────────────────────────────

test "validation: every primitive, a list of lists and an optional list" {
    val _f = fresh();
    val n = try Numbers.decode(
        """{"small": 1, "big": 9007199254740991, "ratio": 0.5, "on": true,
            "extra": {"anything": [1, null]}, "grid": [[1, 2], [3]], "maybe": ["x"]}""",
    );
    assert n.small == 1;
    assert n.ratio == 0.5;
    assert n.on;
    assert n.grid.length == 2;
    assert derived.kindOf(n.extra) == "an object";
    val absent = try Numbers.decode(
        """{"small": 1, "big": 2, "ratio": 1, "on": false, "grid": []}""",
    );
    assert absent.maybe == null;
    assert derived.kindOf(absent.extra) == "null";
}

test "validation: each primitive refuses the others, at its own path" {
    val _f = fresh();
    val r = Numbers.decode(
        """{"small": true, "big": 1.5, "ratio": "x", "on": 1,
            "grid": [[1, "2"], 3], "maybe": [1]}""",
    );
    assert numberCodes(r)
        == "small:invalidType,big:invalidType,ratio:invalidType,on:invalidType,grid[0][1]:invalidType,grid[1]:invalidType,maybe[0]:invalidType";
}

// ── one type, one schema (decision 306) ─────────────────────────────────────

test "validation: a list of a validated type is a field, with each item at its path" {
    val _f = fresh();
    val docs = try json.decode(
        """{"id": "o1", "ship": {"street": "s", "zip": "z"}, "lines": [{"sku": "a", "quantity": 1}, {"sku": 2, "quantity": 2}], "tags": []}""",
    );
    val located = case OrderDoc.parse(docs) {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
    assert located == "lines[1].sku:invalidType";
}

// ── the checks of `#[validated]` ────────────────────────────────────────────

test "validation: a decoded record is checked by its markers" {
    val _f = fresh();
    val ok = try Member.decode("""{"name": "Ana", "age": 30}""");
    assert ok.age == 30;
    val located = case Member.decode("""{"name": "  ", "age": 9}""") {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
    assert located == "name:notBlank,age:minValue";
}

test "validation: a value of the wrong type is reported once, not checked as well" {
    val _f = fresh();
    val located = case Member.decode("""{"name": 7, "age": 9}""") {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
    assert located == "name:invalidType";
}

test "validation: a marker's violation inside a nested record carries the path" {
    val _f = fresh();
    val r = Team.decode(
        """{"lead": {"name": "", "age": 40},
            "members": [{"name": "Bia", "age": 20}, {"name": "Caio", "age": 12}]}""",
    );
    assert teamCodes(r) == "lead.name:notBlank,members[1].age:minValue";
}

// ── step 4: the messages of a union and a set ───────────────────────────────

#[validated]
pub type Slot(
    id: i32 | string,
    seen: Set<i32>,
)

test "validation: an invalidUnion names each arm's first violation, in the type's order" {
    val _s = setMessageSource(builtInOnly());
    val doc = try json.decode("""{"id": true, "seen": [1]}""") catch Json.Null;
    val r = Slot.parse(doc);
    val text = case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> [v.field, v.code, v.message].join("|") })
            .join(",");
    };
    assert text
        == "id|invalidUnion|matches none of the accepted forms - must be a whole number, was a boolean; must be text, was a boolean";
}

test "validation: a repeated item of a set is a duplicate at the second occurrence" {
    val doc = try json.decode(
        """{"id": 1, "seen": [3, 4, 3, 4]}""",
    ) catch Json.Null;
    val r = Slot.parse(doc);
    val text = case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
    assert text == "seen[2]:duplicate,seen[3]:duplicate";
}

test "validation: an absent union is required" {
    val doc = try json.decode("""{"seen": []}""") catch Json.Null;
    val r = Slot.parse(doc);
    val text = case r {
        Ok(_) -> "";
        Error(report) -> report.violations
            .map({ v -> v.field + ":" + v.code })
            .join(",");
    };
    assert text == "id:required";
}

// ── step 5: object policy ───────────────────────────────────────────────────

fn defaultCity() -> string {
    return "Recife";
}

fn noScore() -> i64 {
    return derived.widened(-1.0);
}

#[validated]
pub type Settings(
    #[orElseOf(defaultCity)] city: string,
    #[orElse(3)] retries: i32,
    #[orElse(2.5)] ratio: f64,
    #[orElse(true)] on: bool,
    #[orElse(10)] big: i64,
    #[fallback(1)] #[minValue(1)] #[maxValue(9)] level: i32,
    #[fallbackOf(noScore)] score: i64,
)

fn codesOf<T>(r: @Result<T, ValidationReport>) -> string {
    return derived
        .violationsOf(r)
        .map({ v -> v.field + ":" + v.code })
        .join(",");
}

test "validation: absent keys take their defaults, literal or called" {
    val doc = try json.decode("""{"level": 5, "score": 7}""") catch Json.Null;
    val s = try Settings.parse(doc);
    assert s.city == "Recife";
    assert s.retries == 3;
    assert s.ratio == 2.5;
    assert s.on;
    assert [s.big].join("") == "10";
    assert s.level == 5;
}

test "validation: a fallback answers a value that does not decode and one that fails its checks" {
    val wrong = try json.decode(
        """{"level": "high", "score": "x"}""",
    ) catch Json.Null;
    val s = try Settings.parse(wrong);
    assert s.level == 1;
    assert [s.score].join("") == "-1";
    val outOfRange = try json.decode(
        """{"level": 12, "score": 1}""",
    ) catch Json.Null;
    val t = try Settings.parse(outOfRange);
    assert t.level == 1;
}

test "validation: #[present] refuses an explicit null as invalidType at the key" {
    val doc = try json.decode(
        """{"middle": null, "lucky": 1}""",
    ) catch Json.Null;
    assert codesOf(ProfileHere.parse(doc)) == "middle:invalidType";
}

#[validated]
pub type ProfileHere(
    #[present] middle: ?string,
    lucky: i32,
)

#[validated]
pub type Envelope(
    kind: string,
    #[rest] fields: Dict<string, i32>,
)

test "validation: a #[rest] member is decoded at its own key" {
    val doc = try json.decode(
        """{"kind": "a", "x": 1, "y": "two"}""",
    ) catch Json.Null;
    assert codesOf(Envelope.parse(doc)) == "y:invalidType";
    val ok = try json.decode("""{"kind": "a", "x": 1}""") catch Json.Null;
    val e = try Envelope.parse(ok);
    assert e.fields.keys().join(",") == "x";
}

// ── step 6: the form binder ─────────────────────────────────────────────────

#[validated]
pub type FormSignup(
    email: string,
    age: i32,
    tags: Array<string>,
)

test "validation: bind over form pairs reports what does not read and builds nothing" {
    val pairs = try querystring.parse(
        "email=a%40b.c&age=x&tags=a&tags=b",
    ) catch [];
    assert codesOf(FormSignup.bind(pairs)) == "age:invalidType";
    val good = try querystring.parse(
        "email=a%40b.c&age=30&tags=a&tags=b",
    ) catch [];
    val s = try FormSignup.bind(good);
    assert s.tags.join(",") == "a,b";
    assert s.age == 30;
    assert s.email == "a@b.c";
}

test "validation: a name the record does not declare is the unknown-key rule" {
    val pairs = try querystring.parse("email=a&age=1&admin=1") catch [];
    assert codesOf(FormSignup.bind(pairs)) == "admin:unrecognizedKey";
}

// ── step 8: encode is decode's inverse ──────────────────────────────────────

test "validation: nested records, optionals, lists, unions, sets and dicts round-trip" {
    val text = """{"id": "A1", "ship": {"street": "Rua A", "zip": "50000"}, "lines": [{"sku": "x", "quantity": 2}], "tags": ["t"]}""";
    val doc = try json.decode(text) catch Json.Null;
    val order = try OrderDoc.parse(doc);
    val again = try OrderDoc.parse(try OrderDoc.encode(order));
    assert again.ship.zip == "50000";
    assert again.billing == null;
    assert again.lines.map({ l -> l.sku }).join(",") == "x";
    val slot = try Slot.parse(
        try json.decode("""{"id": "s-1", "seen": [3, 1]}""") catch Json.Null,
    );
    val slotAgain = try Slot.parse(try Slot.encode(slot));
    assert slotAgain.id is string;
    assert slotAgain.seen.size() == 2;
    val env = try Envelope.parse(
        try json.decode("""{"kind": "a", "x": 1, "y": 2}""") catch Json.Null,
    );
    val envAgain = try Envelope.parse(try Envelope.encode(env));
    assert envAgain.fields.keys().join(",") == "x,y";
}

// ── step 11: a variant by reference ─────────────────────────────────────────

#[validated]
pub type Bait { Worm, Fly, Lure }

#[validated]
pub type Rig(
    #[orElse(.Fly)] bait: Bait,
    #[fallback(.Worm)] spare: Bait,
)

test "validation: an enum default and fallback are its variants, by reference" {
    val doc = try json.decode("""{"spare": "Plastic"}""") catch Json.Null;
    val rig = try Rig.parse(doc);
    assert rig.bait == Bait.Fly;
    assert rig.spare == Bait.Worm;
    assert Rig.jsonSchema().contains("\"default\":\"Fly\"");
}

// ── step 12: a transparent type ─────────────────────────────────────────────

#[validated(transparent)]
pub type Email(#[email] value: string)

#[validated]
pub type Invitation(owner: Email, guests: Array<Email>)

test "validation: a transparent type decodes, checks and encodes as its one field" {
    val doc = try json.decode(
        """{"owner": "a@b.c", "guests": ["c@d.e", "nope"]}""",
    ) catch Json.Null;
    assert codesOf(Invitation.parse(doc)) == "guests[1]:email";
    val ok = try json.decode(
        """{"owner": "a@b.c", "guests": []}""",
    ) catch Json.Null;
    val invitation = try Invitation.parse(ok);
    assert invitation.owner.value == "a@b.c";
    val back = try Invitation.encode(invitation);
    assert derived.jsonText(back) == "{\"owner\":\"a@b.c\",\"guests\":[]}";
    val single = try Email.decode("\"x@y.z\"");
    assert single.value == "x@y.z";
    assert Email.jsonSchema()
        == "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"string\",\"format\":\"email\"}";
}
