//// validation — step 4: typed coercion, and the accumulator's lifetime.
////
//// The front's test plan marks this file erlang, because the accumulator is
//// request-scoped and a request is a process only on that row. It runs on BOTH
//// rows anyway, and it has to: `botopink test` compiles every `test/*.bp` on
//// both rows with no per-target gate, and this member's `targets` gates both.
//// So the file asserts what is true on both — coercion, the violation instead
//// of the zero, and the drain — and asks the host for the one answer that
//// differs, through `bindingIsolated()`, which the BEAM half MEASURES by
//// spawning and the node half states about a row that has no second scope.
////
//// Every test resets the accumulator first: the file's subject is a store, and
//// a test that inherited another test's leftovers would be asserting the wrong
//// thing.

import {binding.bindInt, binding.bindBool, binding.bindRequired, binding.bindEpochMillis, binding.bindingReport, binding.bindingCount, binding.bindingReset, binding.bindingIsolated, binding.isIntegerText, binding.bindFloat};
import {report.ValidationReport, report.Violation};
import {messages.setMessageSource, messages.builtInOnly};

fn fresh() -> i32 {
    val _s = setMessageSource(builtInOnly());
    return bindingReset();
}

fn codesOf(r: ValidationReport) -> string {
    return r.violations.map({ v -> v.code }).join(",");
}

fn fieldsOf(r: ValidationReport) -> string {
    return r.violations.map({ v -> v.field }).join(",");
}

// ── the text predicate, which is the same predicate on both rows ────────────

test "validation: what counts as integer text" {
    assert isIntegerText("0");
    assert isIntegerText("12");
    assert isIntegerText("-12");
    assert isIntegerText("+12");
    assert isIntegerText("  12  ");
    assert isIntegerText("") == false;
    assert isIntegerText("  ") == false;
    assert isIntegerText("-") == false;
    assert isIntegerText("12x") == false;
    assert isIntegerText("x12") == false;
    assert isIntegerText("1.5") == false;
    assert isIntegerText("1 2") == false;
}

// ── the binders ─────────────────────────────────────────────────────────────

test "validation: bindInt on an empty string is zero AND a violation" {
    val _f = fresh();
    assert bindInt("age", "") == 0;
    val r = bindingReport();
    assert codesOf(r) == "typeMismatch";
    assert fieldsOf(r) == "age";
    assert r.violations.at(0)?.message ?? "" == "must be a whole number";
}

test "validation: bindInt rejects a trailing character and accepts a number" {
    val _f = fresh();
    assert bindInt("age", "12x") == 0;
    assert bindingCount() == 1;
    assert bindInt("age", "12") == 12;
    assert bindingCount() == 1;
    assert codesOf(bindingReport()) == "typeMismatch";
}

test "validation: bindInt reads the i32 range's ends and refuses past them as a violation" {
    val _f = fresh();
    assert bindInt("age", "2147483647") == 2147483647;
    assert bindInt("age", "-2147483648") == -2147483648;
    assert bindInt("age", " +00042 ") == 42;
    assert bindingCount() == 0;
    assert bindInt("age", "2147483648") == 0;
    assert bindInt("age", "-2147483649") == 0;
    assert bindInt("age", "99999999999999999999") == 0;
    assert bindingCount() == 3;
    assert codesOf(bindingReport()) == "typeMismatch,typeMismatch,typeMismatch";
}

test "validation: bindBool takes four spellings and refuses the rest" {
    val _f = fresh();
    assert bindBool("flag", "true");
    assert bindBool("flag", "1");
    assert bindBool("flag", "false") == false;
    assert bindBool("flag", "0") == false;
    assert bindingCount() == 0;
    assert bindBool("flag", "yes") == false;
    assert bindBool("flag", "TRUE") == false;
    assert bindBool("flag", "") == false;
    val r = bindingReport();
    assert codesOf(r) == "typeMismatch,typeMismatch,typeMismatch";
    assert r.violations.at(0)?.message ?? "" == "must be a boolean";
}

test "validation: bindRequired makes the distinction Request cannot" {
    val _f = fresh();
    assert bindRequired("name", "Ana") == "Ana";
    assert bindingCount() == 0;
    assert bindRequired("name", "") == "";
    assert bindRequired("nick", "   ") == "";
    val r = bindingReport();
    assert codesOf(r) == "required,required";
    assert fieldsOf(r) == "name,nick";
    assert r.violations.at(0)?.message ?? "" == "must be present";
}

test "validation: bindEpochMillis reads an epoch and refuses anything else" {
    val _f = fresh();
    assert bindEpochMillis("ts", "1700000000000") > 0;
    assert bindingCount() == 0;
    val bad = bindEpochMillis("ts", "not-a-time");
    assert bad == 0;
    val r = bindingReport();
    assert codesOf(r) == "typeMismatch";
    assert r.violations.at(0)?.message ?? ""
        == "must be a epoch in milliseconds";
}

// std's `String.parseInt` is the rule: the text is trimmed first, and a numeral
// past the `i64` range is refused on every target (decisions 176, 319).
test "validation: bindEpochMillis trims and refuses a numeral past i64" {
    val _f = fresh();
    assert bindEpochMillis("ts", " +1700000000000 ")
        == bindEpochMillis("ts", "1700000000000");
    assert bindEpochMillis("ts", "9007199254740993") == 9007199254740993l;
    assert bindEpochMillis("ts", "9223372036854775807") > 0;
    assert bindingCount() == 0;
    assert bindEpochMillis("ts", "9223372036854775808") == 0;
    assert bindEpochMillis("ts", "1.5") == 0;
    assert codesOf(bindingReport()) == "typeMismatch,typeMismatch";
}

// ── the accumulator's lifetime ──────────────────────────────────────────────

test "validation: bind everything, then ask once" {
    val _f = fresh();
    val id = bindInt("id", "abc");
    val on = bindBool("active", "maybe");
    val name = bindRequired("name", "");
    assert id == 0;
    assert on == false;
    assert name == "";
    val r = bindingReport();
    assert r.isValid() == false;
    assert fieldsOf(r) == "id,active,name";
    assert codesOf(r) == "typeMismatch,typeMismatch,required";
}

test "validation: asking drains, so the next request starts clean" {
    val _f = fresh();
    val _a = bindInt("age", "x");
    assert bindingCount() == 1;
    assert bindingReport().violations.length == 1;
    assert bindingCount() == 0;
    assert bindingReport().violations.length == 0;
    assert bindingReport().isValid();
}

test "validation: a second scope cannot see this scope's violations" {
    val _f = fresh();
    val _a = bindInt("age", "x");
    assert bindingIsolated();
    assert bindingCount() == 1;
    val _d = bindingReset();
}

test "validation: the report a handler answers with is one problem document" {
    val _f = fresh();
    val _a = bindInt("age", "x");
    val _b = bindRequired("name", "");
    val body = bindingReport().toProblemDetail();
    assert body.contains("\"status\":400");
    assert body.contains(
        "{\"field\":\"age\",\"code\":\"typeMismatch\",\"message\":\"must be a whole number\"}",
    );
    assert body.contains(
        "{\"field\":\"name\",\"code\":\"required\",\"message\":\"must be present\"}",
    );
}

test "validation: bindFloat reads std's numeral grammar and records a mismatch otherwise" {
    val _r = bindingReset();
    assert bindFloat("ratio", " 2.5 ") == 2.5;
    assert bindFloat("ratio", "1e3") == 1000.0;
    assert bindingCount() == 0;
    assert bindFloat("ratio", ".5") == 0.0;
    assert bindFloat("ratio", "abc") == 0.0;
    val report = bindingReport();
    assert report.violations.map({ v -> v.field + ":" + v.code }).join(",")
        == "ratio:typeMismatch,ratio:typeMismatch";
}
