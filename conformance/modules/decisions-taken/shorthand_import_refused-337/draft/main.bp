//// Decision 337 — The shorthand import goes; `mod m;` binds the namespace `m` in the module that declares it.

import {io.terminal.print} from "std";
import {decorators.validated, decorators.refine} from "validation";
import {checks.handles.notReserved, checks.handles.reservedCount};

#[validated]
pub type Account(#[refine(notReserved)] handle: string)

pub fn main() -> void {
    print(reservedCount());
    print(Account(handle: "ana").validate().isValid());
    print(Account(handle: "root").validate().violations
        .map({ v -> v.field + ":" + v.code })
        .join(","));
}
