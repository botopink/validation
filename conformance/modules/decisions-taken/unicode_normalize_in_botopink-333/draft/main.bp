//// Decision 333 — `unicode.normalize` is a botopink normalizer on the four targets, its tables generated by a Zig build step; a prebuilt wasm library is a further `@External.Wasm` form, for later uses.

import {io.terminal.print} from "std";
import {unicode, unicode.NormalizationForm} from "std";
import {decorators.validated, decorators.normalized, decorators.notBlank} from "validation";
import {report.ValidationReport} from "validation";

// A display name is stored in NFKD: the compatibility forms are split apart.
#[validated]
pub type Author(#[normalized("NFKD")] #[notBlank] name: string)

fn codes(s: string) -> string {
    return unicode.codepoints(s).map({ c -> c.toString() }).join(" ");
}

pub fn main() -> void {
    print(codes(unicode.normalize("ǅ", NormalizationForm.NFKD)));
    val author = try Author.decode("""{"name": "ǅ"}""") catch Author(name: "");
    print(codes(author.name));
    print(unicode.normalize("e\u{301}", NormalizationForm.NFC) == "é");
}
