//// Decision 330 — `?T` is read with TypeScript's operators and has no methods; `result` goes; a type declared in a type is its associated type.

import {io.terminal.print} from "std";
import {decorators.validated, decorators.minLength} from "validation";
import {report.ValidationReport} from "validation";

#[validated]
pub type Profile(
    #[minLength(2)] name: string,
    bio: ?string,
    age: ?i32,
    website: ?string,
)

pub type Lookup(profile: ?Profile) {
    pub type Source(label: string)
}

fn load(source: Lookup.Source, text: string) -> Lookup {
    val read: Result<Profile, ValidationReport> = Profile.decode(text);
    if (read.isError()) return Lookup(profile: null);
    return Lookup(profile: read.unwrapOr(Profile(name: "", bio: null, age: null, website: null)));
}

pub fn main() -> void {
    val source = Lookup.Source(label: "signup form");
    val found = load(source, """{"name": "ana", "bio": "botopink fan", "age": null, "website": null}""");
    val missing = load(source, """{"name": "a"}""");

    val bioLength = found.profile?.bio?.length() ?? 0;
    val age = found.profile?.age ?? 18;
    val described = (found.profile?.website ?? "") != ""
        || (found.profile?.bio ?? "") != "";
    val missingName = missing.profile?.name ?? "anonymous";
    val name = found.profile!.name;

    print(source.label, bioLength, age, described, missingName, name);
}
