//// validation — the violation and the report.
////
//// Moved from rakun front 14's validation member (decision 116 rule 5).
//// This file is the one every other file in the library stands on, and its
//// only import is std's `json` writer: no host cell of its own, nothing that
//// reaches a socket or the filesystem. `T.constraints()` and
//// `ValidationReport` are what a client bundle obtains, and it obtains them
//// without importing anything that does I/O.
////
//// JSON is written with `json.quote` / `json.object` / `json.array` (std,
//// decision 116 rule 3), so every control character in a message is escaped
//// as RFC 8259 requires — the private escaper this file used to carry escaped
//// five characters only.
////
//// A `ValidationReport` is a LIST of violations, never a first failure: the
//// binding pattern the module is built around is "bind everything, then ask
//// once", and a report that stopped at the first bad field could not answer
//// that question. Order is declaration order, and `merge` keeps the receiver's
//// violations in front of the argument's, so a report built from a record's
//// fields reads in the order the record declares them.

import {path.parts, path.parent};
import {json, collections.Dict} from "std";

// One failed constraint. `code` is the constraint's own name (`notBlank`,
// `sizeBetween`, an application constraint's `code()`); `message` is the
// resolved, interpolated template; `invalidValue` is what was rejected,
// rendered as a string so the report is one shape for every field type.
pub type Violation(
    field: string,
    code: string,
    message: string,
    invalidValue: string,
) {
    // `#[message("…")]`: the violations of the marker it follows, under the
    // text the field gives instead of the template.
    pub fn restated(vs: Array<Violation>, text: string) -> Array<Violation> {
        return vs.map({ v ->
            Violation(
                field: v.field,
                code: v.code,
                message: text,
                invalidValue: v.invalidValue,
            );
        });
    }

    // A check of an optional field under `#[stopOnFirst]`: its violations
    // when the value is present, none when it is null.
    pub fn onlyIf(present: bool, vs: Array<Violation>) -> Array<Violation> {
        val none: Array<Violation> = [];
        if (present) return vs else return none;
    }

    // `#[stopOnFirst]`: the violations of the first check that answered any,
    // in the order the field writes its markers; none when every check passed.
    pub fn firstFailing(lists: Array<Array<Violation>>) -> Array<Violation> {
        val failing = lists.filter({ vs -> vs.length > 0 });
        val none: Array<Violation> = [];
        return failing.at(0) ?? none;
    }
}

pub type ValidationReport(
    violations: Array<Violation>,
) {
    pub fn isValid(self: Self) -> bool {
        return self.violations.length == 0;
    }

    // The receiver's violations come first. `Array.append` is `$0 ++ $1` on
    // erlang and `concat` on node, both of which answer a NEW array — neither
    // mutates the receiver, so merging twice from the same report is stable.
    pub fn merge(self: Self, other: ValidationReport) -> ValidationReport {
        return ValidationReport(
            violations: self.violations.append(other.violations),
        );
    }

    pub fn toJson(self: Self) -> string {
        val rows = self.violations.map({ v -> violationJson(v) });
        return json.object([#("errors", json.array(rows))]);
    }

    // RFC 9457. `type` is `about:blank` because the status code alone carries
    // the semantics; `errors` is the same array `toJson` writes, so an
    // application never has two error shapes to read.
    pub fn toProblemDetail(self: Self) -> string {
        val rows = self.violations.map({ v -> violationJson(v) });
        return json.object(
            [
                #("type", json.quote("about:blank")),
                #("title", json.quote("Validation failed")),
                #("status", "400"),
                #("errors", json.array(rows)),
            ],
        );
    }

    // `z.flattenError`: the messages of the document itself — a violation at
    // the root, or a key the root object does not declare — and, per first
    // path segment, the messages under that field, in report order.
    pub fn flatten(self: Self) -> Flat {
        var form: Array<string> = [];
        var fields: Dict<string, Array<string>> = Dict.empty();
        var i = 0;
        while (i < self.violations.length) {
            val v = self.violations.at(i);
            if (v != null) {
                val ps = parts(locatedAt(v));
                if (ps.length == 0) form = form.append([v.message]) else {
                    val head = ps.slice(0, 1).map({ p -> p[1] }).join("");
                    val before: Array<string> = fields.at(head) ?? [];
                    fields = fields.insert(head, before.append([v.message]));
                }
            }
            i = i + 1;
        }
        return Flat(formErrors: form, fieldErrors: fields);
    }

    // `z.treeifyError`: the messages placed where the document holds the value
    // they are about — `properties` by key, `items` by index (an index nothing
    // was said about is an empty tree).
    pub fn tree(self: Self) -> ReportTree {
        return self.violations.fold(
            ReportTree.none(),
            { acc, v -> placed(acc, parts(locatedAt(v)), v.message) },
        );
    }

    // `z.prettifyError`: `✖ <message>`, then `  → at <path>` when the value
    // is not the document itself; one violation after another, report order.
    pub fn pretty(self: Self) -> string {
        return self.violations.map({ v -> prettyLine(v) }).join("\n");
    }

    pub fn empty() -> ValidationReport {
        val none: Array<Violation> = [];
        return ValidationReport(violations: none);
    }

    pub fn of(violations: Array<Violation>) -> ValidationReport {
        return ValidationReport(violations: violations);
    }
}

// One violation as a JSON object. `invalidValue` is NOT written: a report is
// rendered straight into an HTTP body by `toProblemDetail`, and echoing the
// rejected value there is how a validation error becomes a reflected-input
// hole. The value stays on the `Violation` for a log line to read.
pub fn violationJson(v: Violation) -> string {
    return json.object(
        [
            #("field", json.quote(v.field)),
            #("code", json.quote(v.code)),
            #("message", json.quote(v.message)),
        ],
    );
}

// One violation, built where every constraint builds one.
pub fn violation(
    field: string,
    code: string,
    message: string,
    invalidValue: string,
) -> Violation {
    return Violation(
        field: field,
        code: code,
        message: message,
        invalidValue: invalidValue,
    );
}

// The two answers a constraint gives, as the array the emitted validator
// appends: no violation, or exactly one.
pub fn noViolation() -> Array<Violation> {
    val none: Array<Violation> = [];
    return none;
}

pub fn oneViolation(v: Violation) -> Array<Violation> {
    return [v];
}

// ── step 9: the report's views ──────────────────────────────────────────────

pub type Flat(
    formErrors: Array<string>,
    fieldErrors: Dict<string, Array<string>>,
)

pub type ReportTree(
    errors: Array<string>,
    properties: Dict<string, ReportTree>,
    items: Array<ReportTree>,
) {
    // The tree of a value nothing was said about.
    pub fn none() -> ReportTree {
        val noErrors: Array<string> = [];
        val noItems: Array<ReportTree> = [];
        return ReportTree(
            errors: noErrors,
            properties: Dict.empty(),
            items: noItems,
        );
    }
}

// Where a violation is said: at its own path, except an undeclared key, which
// is a fault of the object holding it (Zod reports `unrecognized_keys` there).
fn locatedAt(v: Violation) -> string {
    if (v.code == "unrecognizedKey") return parent(v.field);
    return v.field;
}

fn prettyLine(v: Violation) -> string {
    val at = locatedAt(v);
    if (at == "") return "✖ " + v.message;
    return "✖ " + v.message + "\n  → at " + at;
}

fn placed(
    tree: ReportTree,
    ps: Array<#(bool, string)>,
    message: string,
) -> ReportTree {
    if (ps.length == 0)
        return ReportTree(
            errors: tree.errors.append([message]),
            properties: tree.properties,
            items: tree.items,
        );
    val head = ps.slice(0, 1);
    val rest = ps.slice(1, ps.length);
    val isIndex = head.map({ p -> p[0] }).filter({ b -> b }).length > 0;
    val name = head.map({ p -> p[1] }).join("");
    if (isIndex) {
        val at = name
            .split("")
            .fold(0, { acc, c -> acc * 10 + "0123456789".indexOf(c) });
        var items = tree.items;
        while (items.length <= at) {
            items = items.append([ReportTree.none()]);
        }
        val child = items.at(at) ?? ReportTree.none();
        val updated = placed(child, rest, message);
        val replaced = items
            .slice(0, at)
            .append([updated])
            .append(items.slice(at + 1, items.length));
        return ReportTree(
            errors: tree.errors,
            properties: tree.properties,
            items: replaced,
        );
    }
    val child = tree.properties.at(name) ?? ReportTree.none();
    return ReportTree(
        errors: tree.errors,
        properties: tree.properties.insert(name, placed(child, rest, message)),
        items: tree.items,
    );
}
