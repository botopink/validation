// ── step 4: literals, closed sets ───────────────────────────────────────────
//
// `#[literal(x)]` holds a `string`, `i32` or `bool` field to one value (the
// argument's lexeme is read as the field's type); `#[oneOf("a,b,c")]` holds a
// text field to a closed set, comma-joined because a decorator argument is one
// raw lexeme (`language-gaps.md`).

pub fn literal(comptime decl: @Decl, comptime expected: string | i32 | bool) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[literal] must annotate a field");
}

pub fn oneOf(comptime decl: @Decl, comptime options: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[oneOf] must annotate a field");
    val problem = textArgProblem("oneOf", "options", options);
    if (problem != "") decl.fail(problem);
    val parts = options.split(",");
    if (parts.filter({ o -> o == "" }).length > 0)
        decl.fail(
            "#[oneOf]: an option may not be empty - write the options comma-joined, as \"net,rod,trap\"",
        );
    if (parts.length < 2)
        decl.fail(
            "#[oneOf]: one option is a #[literal] - write two or more, comma-joined",
        );
}

// Every marker `#[validated]` reads, in the order of this file — what
// `#[validated]` asks of a field and what `test/refusal_test.bp` counts.
pub fn markerNames() -> Array<string> {
    return "notNull|notBlank|notEmpty|sizeBetween|minValue|maxValue|positive|positiveOrZero|email|pattern|pastDate|futureDate|constraint|minLength|maxLength|length|startsWith|endsWith|includes|uppercase|lowercase|emailHtml5|emailRfc5322|emailUnicode|uuid|uuidV|guid|url|urlHost|urlProtocol|httpUrl|hostname|e164|emoji|base64|base64url|hex|jwt|jwtAlg|nanoid|cuid|cuid2|ulid|ipv4|ipv6|mac|macDelimiter|cidrv4|cidrv6|creditCard|currencyCode|iban|hash|hashEnc|isoDate|isoTime|isoTimePrecision|isoDatetime|isoDatetimeOffset|isoDatetimeLocal|isoDatetimePrecision|isoDuration|gt|lt|negative|negativeOrZero|multipleOf|safeInt|float32|afterIso|beforeIso|literal|oneOf".split(
        "|",
    );
}

// ── the parse half of `#[validated]` (decisions 306, 327) ──────────────────
//
// The type is the only schema. `#[validated]` gives it, beside `validate()`
// and `constraints()`, the members that read and write it:
//
//     pub fn parse(input: Json) -> @Result<Self, ValidationReport>        // Player.parse(doc)
//     pub fn parseAt(input: Json, at: string) -> @Result<Self, ValidationReport>
//     pub fn decode(text: string) -> @Result<Self, ValidationReport>
//     pub fn bind(pairs: Array<#(string, string)>) -> @Result<Self, ValidationReport>
//     pub fn encode(v: Self) -> @Result<Json, ValidationReport>
//     pub fn jsonSchema() -> string
//     pub fn options() -> Array<string>                                  // an enum
//
// and three it calls on another type of the same kind — `__json`,
// `__schemaNode`, `__schemaDefs` — named with `__` because no application
// calls them. THE NAMES ARE A CONTRACT: a field whose type is another
// `#[validated]` type is decoded by `ThatType.parseAt`, encoded by
// `ThatType.__json`, described by `ThatType.__schemaNode` — a decorator sees
// one declaration, and never needs a second; members travel with the type to
// every importer (decision 216).
//
// THE DECODER IS STRAIGHT-LINE CODE: one statement per field, every field
// decoded, every violation collected, the record constructed only when there
// are none, then `validate()` run on it. An undeclared key is a violation
// (`unrecognizedKey`).
//
// WHAT THE EMITTED CODE NEEDS IN SCOPE. The library is named through ONE
// namespace, `derived` (the machinery, not a schema API), and the types the
// signatures spell are leaves (a type cannot be named through a namespace):
//
//     import {derived, report.ValidationReport, report.Violation, table.constraintTableJson} from "validation";
//     import {json.Json} from "std";

fn schemaIsList(t: string) -> bool {
    return (t.startsWith("Array<") && t.endsWith(">")) || t.endsWith("[]");
}

fn schemaItemOf(t: string) -> string {
    if (t.endsWith("[]")) return t.slice(0, t.length() - 2);
    return t.slice(6, t.length() - 1);
}

fn schemaIsName(t: string) -> bool {
    if (t == "") return false;
    val allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_";
    val head = t.slice(0, 1);
    val startsUpper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".indexOf(head) >= 0;
    val strange = t.split("").filter({ c -> allowed.indexOf(c) < 0 }).length;
    return startsUpper && strange == 0;
}

fn schemaIsBuiltin(t: string) -> bool {
    return t == "string"
        || t == "i32"
        || t == "i64"
        || t == "f64"
        || t == "bool"
        || t == "Json";
}

// A type that names another `#[validated]` declaration — a record or an enum,
// decoded by calling `ThatType.parseAt` by name.
fn schemaIsDeclared(t: string) -> bool {
    return schemaIsName(t) && schemaIsBuiltin(t) == false;
}

// `t` cut at every `sep` outside `<…>`, `(…)` and `[…]`, each part trimmed:
// the arms of a union, the items of a tuple, the arguments of a generic.
fn splitTop(t: string, sep: string) -> Array<string> {
    var parts: Array<string> = [];
    var depth = 0;
    var start = 0;
    var i = 0;
    val n = t.length();
    while (i < n) {
        val c = t.slice(i, i + 1);
        if ("<([".indexOf(c) >= 0) depth = depth + 1;
        if (">)]".indexOf(c) >= 0) depth = depth - 1;
        if (depth == 0 && c == sep) {
            parts.push(t.slice(start, i).trim());
            start = i + 1;
        }
        i = i + 1;
    }
    parts.push(t.slice(start, n).trim());
    return parts;
}

fn schemaIsUnion(t: string) -> bool {
    if (t.startsWith("?")) return false;
    return splitTop(t, "|").length > 1;
}

fn schemaIsTuple(t: string) -> bool {
    return t.startsWith("#(") && t.endsWith(")");
}

fn schemaTupleItems(t: string) -> Array<string> {
    return splitTop(t.slice(2, t.length() - 1), ",");
}

fn schemaIsDict(t: string) -> bool {
    return t.startsWith("Dict<") && t.endsWith(">");
}

fn schemaIsSet(t: string) -> bool {
    return t.startsWith("Set<") && t.endsWith(">");
}

// The arguments of `Dict<K, V>` / `Set<T>`.
fn schemaArgs(t: string) -> Array<string> {
    val open = t.indexOf("<");
    return splitTop(t.slice(open + 1, t.length() - 1), ",");
}

// The type one wrapper holds: `T` of `?T`, the item of a list or a set; `""`
// when `t` is not a wrapper.
fn schemaInner(t: string) -> string {
    if (t.startsWith("?")) return t.slice(1, t.length());
    if (schemaIsList(t)) return schemaItemOf(t);
    if (schemaIsSet(t)) return schemaArgs(t).slice(0, 1).join("");
    return "";
}

fn schemaDictKeySupported(k: string) -> bool {
    return k == "string" || k == "i32" || schemaIsDeclared(k);
}

fn schemaSupported(t: string) -> bool {
    if (schemaIsBuiltin(t)) return true;
    if (schemaIsUnion(t))
        return splitTop(t, "|").filter(
            { a -> schemaSupported(a) == false },
        ).length
            == 0;
    if (schemaIsTuple(t)) {
        val items = schemaTupleItems(t);
        val labelled = items.filter(
            { it -> splitTop(it, ":").length > 1 },
        ).length;
        return labelled == 0
            && items.filter({ it -> schemaSupported(it) == false }).length == 0;
    }
    if (schemaIsDict(t)) {
        val kv = schemaArgs(t);
        if (kv.length != 2) return false;
        return schemaDictKeySupported(kv.slice(0, 1).join(""))
            && schemaSupported(kv.slice(1, 2).join(""));
    }
    val inner = schemaInner(t);
    if (inner != "") return schemaSupported(inner);
    return schemaIsName(t);
}

// A DECODER HANDED TO A COMBINATOR IS A FUNCTION OF THE APPLICATION'S MODULE.
// `derived.optionalOf`, `decodeArrayOf`, `decodeSetOf` and `decodeDictOf` take
// the inner decoder as a value, and a library function cannot be that value
// from emitted code: a namespace member is resolved where it is CALLED, not
// where it is passed (`derived.decodeString` as an argument is "unbound
// variable 'schemas'"). A lambda that calls it works in a consumer and not in
// a module of this package, where the namespace is the bare `import
// {schemas};` (`schemas is not defined` on node, `decodeString/3 undefined` on
// erlang) - and this library's own tests are such modules. So each part of a
// field's type below its own level gets one emitted function, named after the
// record, the field and the part's place in the type (`0` the field, `0_1`
// its second part, …), whose body is the call: a plain function of the module
// the record is declared in. A tuple and a union get one for themselves too —
// their decoder is straight-line code over their parts.
fn schemaHelperName(owner: string, field: string, id: string) -> string {
    return "__decode" + owner + "_" + field + "_" + id;
}

// The name of a function decoding `t` — what a combinator is handed. Always
// an emitted function of the application's module, a declared type's member
// included, the function that calls it being what is passed.
// LANGUAGE GAP: a static member is not a value on erlang — `Address.parseAt`
// as an argument is "variable 'Address' is unbound".
fn schemaRef(t: string, owner: string, field: string, id: string) -> string {
    return schemaHelperName(owner, field, id);
}

// The expression that decodes a value of type `t` read from `source` at `path`.
fn schemaCall(
    t: string,
    source: string,
    path: string,
    owner: string,
    field: string,
    id: string,
) -> string {
    val tail = "(" + source + ", " + path;
    if (t == "string") return "derived.decodeString" + tail + ")";
    if (t == "i32") return "derived.decodeInt" + tail + ")";
    if (t == "i64") return "derived.decodeLong" + tail + ")";
    if (t == "f64") return "derived.decodeFloat" + tail + ")";
    if (t == "bool") return "derived.decodeBool" + tail + ")";
    if (t == "Json") return "derived.decodeJson" + tail + ")";
    if (schemaIsUnion(t) || schemaIsTuple(t))
        return schemaHelperName(owner, field, id) + tail + ")";
    if (schemaIsDict(t)) {
        val kv = schemaArgs(t);
        return "derived.decodeDictOf"
            + tail
            + ", "
            + schemaHelperName(owner, field, id + "_0")
            + ", "
            + schemaRef(kv.slice(1, 2).join(""), owner, field, id + "_1")
            + ")";
    }
    val inner = schemaInner(t);
    if (inner == "") return t + ".parseAt" + tail + ")";
    val ref = schemaRef(inner, owner, field, id + "_0");
    if (t.startsWith("?"))
        return "derived.optionalOf" + tail + ", " + ref + ")";
    if (schemaIsSet(t)) return "derived.decodeSetOf" + tail + ", " + ref + ")";
    return "derived.decodeArrayOf" + tail + ", " + ref + ")";
}

fn schemaResult(t: string) -> string {
    return "(input: Json, at: string) -> @Result<"
        + t
        + ", ValidationReport> {\n";
}

// The function named by `schemaRef(t, …, id)`, and what it needs.
fn schemaNeed(t: string, owner: string, field: string, id: string) -> string {
    if (schemaIsUnion(t) || schemaIsTuple(t))
        return schemaHelpers(t, owner, field, id);
    return "fn "
        + schemaHelperName(owner, field, id)
        + schemaResult(t)
        + "    return try "
        + schemaCall(t, "input", "at", owner, field, id)
        + ";\n}\n"
        + schemaHelpers(t, owner, field, id);
}

// The emitted functions `schemaCall(t, …, id)` names, outermost first; `""`
// for a builtin or a declared type.
fn schemaHelpers(
    t: string,
    owner: string,
    field: string,
    id: string,
) -> string {
    if (schemaIsUnion(t)) return schemaUnionFn(t, owner, field, id);
    if (schemaIsTuple(t)) return schemaTupleFn(t, owner, field, id);
    if (schemaIsDict(t)) {
        val kv = schemaArgs(t);
        val k = kv.slice(0, 1).join("");
        val keyCall = if (k == "i32")
            "derived.decodeIntKey(input, at)"
        else if (schemaIsDeclared(k))
            k + ".parseAt(input, at)"
        else
            "derived.decodeString(input, at)";
        val keyFn = "fn "
            + schemaHelperName(owner, field, id + "_0")
            + schemaResult(k)
            + "    return try "
            + keyCall
            + ";\n}\n";
        return keyFn
            + schemaNeed(kv.slice(1, 2).join(""), owner, field, id + "_1");
    }
    val inner = schemaInner(t);
    if (inner == "") return "";
    return schemaNeed(inner, owner, field, id + "_0");
}

// A union: the arms in the order the type writes them, the first that accepts
// is the value; none → ONE `invalidUnion` naming each arm's first violation.
// Absent is `required` unless an arm takes it (`?T`, `Json`).
fn schemaUnionFn(
    t: string,
    owner: string,
    field: string,
    id: string,
) -> string {
    val arms = splitTop(t, "|");
    val nullable = arms.filter({ a -> a.startsWith("?") || a == "Json" }).length
        > 0;
    var body: Array<string> = [];
    var parts: Array<string> = [];
    var deps: Array<string> = [];
    if (nullable == false)
        body.push(
            "    if (derived.isNull(input)) { throw derived.required(at); }",
        );
    var j = 0;
    while (j < arms.length) {
        val a = arms.slice(j, j + 1).join("");
        val armId = id + "_" + [j].join("");
        val v = "__a" + [j].join("");
        body.push(
            "    val "
                + v
                + " = "
                + schemaCall(a, "input", "at", owner, field, armId)
                + ";",
        );
        body.push(
            "    if (derived.violationsOf("
                + v
                + ").length == 0) return try "
                + v
                + ";",
        );
        parts.push("derived.violationsOf(" + v + ")");
        deps.push(schemaHelpers(a, owner, field, armId));
        j = j + 1;
    }
    return "fn "
        + schemaHelperName(owner, field, id)
        + schemaResult(t)
        + body.join("\n")
        + "\n    throw derived.noArm(at, input, ["
        + parts.join(", ")
        + "]);\n}\n"
        + deps.join("");
}

// A tuple: a list of exactly its length, each item at `at[i]`, every item's
// violations reported, the tuple built only when there are none.
fn schemaTupleFn(
    t: string,
    owner: string,
    field: string,
    id: string,
) -> string {
    val items = schemaTupleItems(t);
    var decoders: Array<string> = [];
    var gathers: Array<string> = [];
    var values: Array<string> = [];
    var deps: Array<string> = [];
    var i = 0;
    while (i < items.length) {
        val it = items.slice(i, i + 1).join("");
        val n = [i].join("");
        val itemId = id + "_" + n;
        decoders.push(
            "    val __t"
                + n
                + " = "
                + schemaCall(
                    it,
                    "derived.itemOf(__items, " + n + ")",
                    "derived.indexPath(at, " + n + ")",
                    owner,
                    field,
                    itemId,
                )
                + ";",
        );
        gathers.push(
            "    __vs = __vs.append(derived.violationsOf(__t" + n + "));",
        );
        values.push("try __t" + n);
        deps.push(schemaHelpers(it, owner, field, itemId));
        i = i + 1;
    }
    return "fn "
        + schemaHelperName(owner, field, id)
        + schemaResult(t)
        + "    val __items = try derived.tupleItems(input, at, "
        + [items.length].join("")
        + ");\n"
        + decoders.join("\n")
        + "\n    var __vs: Array<Violation> = [];\n"
        + gathers.join("\n")
        + "\n    if (__vs.length > 0) { throw ValidationReport(violations: __vs); }\n"
        + "    return #("
        + values.join(", ")
        + ");\n}\n"
        + deps.join("");
}

// ── encoding (step 8) ───────────────────────────────────────────────────────
//
// `T.__json(v) -> Json` writes a value as the document its decoder reads, by
// the same name contract (`ThatType.__json` for a field of another
// `#[validated]` type); `T.encode(v) -> @Result<Json, ValidationReport>` runs
// the type's own checks first — refinements run in both directions — and
// a value that fails them is an `Error`, not a document. Each part below a
// field's level gets one emitted function, `__encode<Record>_<field>_<place>`,
// for the reason the decoders do.

fn encHelperName(owner: string, field: string, id: string) -> string {
    return "__encode" + owner + "_" + field + "_" + id;
}

fn encRef(t: string, owner: string, field: string, id: string) -> string {
    return encHelperName(owner, field, id);
}

fn encCall(
    t: string,
    e: string,
    owner: string,
    field: string,
    id: string,
) -> string {
    if (t == "string") return "Json.Str(" + e + ")";
    if (t == "i32") return "derived.encodeInt(" + e + ")";
    if (t == "i64") return "derived.encodeLong(" + e + ")";
    if (t == "f64") return "Json.Num(" + e + ")";
    if (t == "bool") return "Json.Bool(" + e + ")";
    if (t == "Json") return e;
    if (schemaIsUnion(t) || schemaIsTuple(t))
        return encHelperName(owner, field, id) + "(" + e + ")";
    if (schemaIsDict(t)) {
        val kv = schemaArgs(t);
        return "derived.encodeDictOf("
            + e
            + ", "
            + encHelperName(owner, field, id + "_0")
            + ", "
            + encRef(kv.slice(1, 2).join(""), owner, field, id + "_1")
            + ")";
    }
    val inner = schemaInner(t);
    if (inner == "") return t + ".__json(" + e + ")";
    val ref = encRef(inner, owner, field, id + "_0");
    if (t.startsWith("?"))
        return "derived.encodeOptional(" + e + ", " + ref + ")";
    if (schemaIsSet(t)) return "derived.encodeSetOf(" + e + ", " + ref + ")";
    return "derived.encodeArrayOf(" + e + ", " + ref + ")";
}

fn encNeed(t: string, owner: string, field: string, id: string) -> string {
    if (schemaIsUnion(t) || schemaIsTuple(t))
        return encHelpers(t, owner, field, id);
    return "fn "
        + encHelperName(owner, field, id)
        + "(x: "
        + t
        + ") -> Json {\n    return "
        + encCall(t, "x", owner, field, id)
        + ";\n}\n"
        + encHelpers(t, owner, field, id);
}

fn encHelpers(t: string, owner: string, field: string, id: string) -> string {
    if (schemaIsUnion(t)) {
        val arms = splitTop(t, "|");
        var body: Array<string> = [];
        var deps: Array<string> = [];
        var j = 0;
        while (j < arms.length) {
            val a = arms.slice(j, j + 1).join("");
            val armId = id + "_" + [j].join("");
            body.push(
                "    if (__x is "
                    + a
                    + ") {\n        return "
                    + encCall(a, "__x", owner, field, armId)
                    + ";\n    }",
            );
            deps.push(encHelpers(a, owner, field, armId));
            j = j + 1;
        }
        return "fn "
            + encHelperName(owner, field, id)
            + "(x: "
            + t
            + ") -> Json {\n    val __x = x;\n"
            + body.join("\n")
            + "\n    return Json.Null;\n}\n"
            + deps.join("");
    }
    if (schemaIsTuple(t)) {
        val items = schemaTupleItems(t);
        var parts: Array<string> = [];
        var deps: Array<string> = [];
        var i = 0;
        while (i < items.length) {
            val it = items.slice(i, i + 1).join("");
            val n = [i].join("");
            parts.push(
                encCall(it, "__x[" + n + "]", owner, field, id + "_" + n),
            );
            deps.push(encHelpers(it, owner, field, id + "_" + n));
            i = i + 1;
        }
        return "fn "
            + encHelperName(owner, field, id)
            + "(x: "
            + t
            + ") -> Json {\n    val __x = x;\n    return Json.Arr(["
            + parts.join(", ")
            + "]);\n}\n"
            + deps.join("");
    }
    if (schemaIsDict(t)) {
        val kv = schemaArgs(t);
        val k = kv.slice(0, 1).join("");
        val keyBody = if (k == "string")
            "k"
        else if (k == "i32")
            "derived.intKeyText(k)"
        else
            "derived.textOfJson(" + k + ".__json(k))";
        return "fn "
            + encHelperName(owner, field, id + "_0")
            + "(k: "
            + k
            + ") -> string {\n    return "
            + keyBody
            + ";\n}\n"
            + encNeed(kv.slice(1, 2).join(""), owner, field, id + "_1");
    }
    val inner = schemaInner(t);
    if (inner == "") return "";
    return encNeed(inner, owner, field, id + "_0");
}

// What `#[validated]` on an enum writes: the variant's name; tagged, the payload's
// object with the tag member first.
fn encEnumMembers(
    name: string,
    variants: Array<string>,
    tag: string,
) -> Array<string> {
    val arms = variants.map({ v ->
        if (tag == "")
            "        " + v + " -> Json.Str(\"" + v + "\");"
        else
            "        "
                + v
                + "(value) -> derived.tagged("
                + name
                + v
                + ".__json(value), \""
                + tag
                + "\", \""
                + v
                + "\");";
    });
    return [
        "pub fn __json(v: "
            + name
            + ") -> Json {\n    return case v {\n"
            + arms.join("\n")
            + "\n    };\n}",
        "pub fn encode(v: "
            + name
            + ") -> @Result<Json, ValidationReport> {\n    return "
            + name
            + ".__json(v);\n}",
    ];
}

// ── JSON Schema (step 9) ────────────────────────────────────────────────────
//
// `#[validated]` emits, beside the decoder, the type's JSON Schema (draft
// 2020-12) as `Json` built by the emitted code — `T.__schemaNode()` the type's
// own node, `T.__schemaDefs(acc)` the nodes of every type it reaches,
// `T.jsonSchema()` the document (`derived.documentOf`): a
// field of another `#[validated]` type is `{"$ref": "#/$defs/<Name>"}`, of the
// document's own type `{"$ref": "#"}`, so recursion is finite. A marker becomes
// its keyword (ZOD_DOCUMENTATION.md § 8.3: a format, `contentEncoding`, a
// `pattern`, a bound); one with no keyword — a registered constraint, a date
// bound, a walk-checked format, a rule — is unrepresentable: under
// `#[jsonSchema]` on the type a compile error naming the field and the marker,
// without it the field's node is `{}` (Zod's `unrepresentable: "any"`).

fn jsText(s: string) -> string {
    return "\"" + s.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"") + "\"";
}

fn jsStr(s: string) -> string {
    return "Json.Str(" + jsText(s) + ")";
}

fn jsKw(name: string, value: string) -> string {
    return "#(" + jsText(name) + ", " + value + ")";
}

fn jsObj(members: Array<string>) -> string {
    return "Json.Obj([" + members.join(", ") + "])";
}

fn jsArr(items: Array<string>) -> string {
    return "Json.Arr([" + items.join(", ") + "])";
}

fn jsNum(lexeme: string) -> string {
    return "Json.Num(" + asF64(lexeme) + ")";
}

// `s` as a regular expression that matches it literally.
fn regexEscaped(s: string) -> string {
    val special = "\\^$.|?*+()[]{}/";
    return s
        .split("")
        .map({ c -> if (special.indexOf(c) >= 0) "\\" + c else c })
        .join("");
}

// A literal lexeme as the `Json` it is: text, a boolean, a number, or an
// enum's variant (`.Tuna`, written as its name).
fn literalJson(l: string) -> string {
    if (l.startsWith("\"")) return jsStr(unquoted(l));
    if (l.startsWith(".")) return jsStr(l.slice(1, l.length()));
    if (l == "true" || l == "false") return "Json.Bool(" + l + ")";
    return jsNum(l);
}

fn formatOf(n: string) -> string {
    if (n == "email"
        || n == "emailHtml5"
        || n == "emailRfc5322"
        || n == "emailUnicode")
        return "email";
    if (n == "uuid" || n == "guid" || n == "uuidV") return "uuid";
    if (n == "url" || n == "httpUrl") return "uri";
    if (n == "hostname") return "hostname";
    if (n == "ipv4") return "ipv4";
    if (n == "ipv6") return "ipv6";
    if (n == "isoDate") return "date";
    if (n == "isoDatetime" || n == "isoDatetimeOffset") return "date-time";
    if (n == "isoDuration") return "duration";
    return "";
}

fn patternOf(n: string) -> string {
    if (n == "nanoid") return nanoidPattern();
    if (n == "cuid2") return cuid2Pattern();
    if (n == "ulid") return ulidPattern();
    if (n == "e164") return e164Pattern();
    if (n == "notBlank") return "\\S";
    return "";
}

// The keywords one marker adds to the node of a value of type `t`; a single
// `"!"`-led element when it has none.
fn markerKeywords(n: string, args: Array<string>, t: string) -> Array<string> {
    val first = args.slice(0, 1).join("");
    val second = args.slice(1, 2).join("");
    val text = t == "string";
    val list = schemaIsList(t) || schemaIsSet(t);
    val dict = schemaIsDict(t);
    val minKey = if (text)
        "minLength"
    else if (dict)
        "minProperties"
    else
        "minItems";
    val maxKey = if (text)
        "maxLength"
    else if (dict)
        "maxProperties"
    else
        "maxItems";
    val none: Array<string> = [];
    if (n == "minLength") return [jsKw(minKey, jsNum(first))];
    if (n == "maxLength") return [jsKw(maxKey, jsNum(first))];
    if (n == "length")
        return [jsKw(minKey, jsNum(first)), jsKw(maxKey, jsNum(first))];
    if (n == "sizeBetween")
        return [jsKw(minKey, jsNum(first)), jsKw(maxKey, jsNum(second))];
    if (n == "notEmpty") return [jsKw(minKey, jsNum("1"))];
    if (n == "notNull") return none;
    if (n == "minValue") return [jsKw("minimum", jsNum(first))];
    if (n == "maxValue") return [jsKw("maximum", jsNum(first))];
    if (n == "positive") return [jsKw("exclusiveMinimum", jsNum("0"))];
    if (n == "positiveOrZero") return [jsKw("minimum", jsNum("0"))];
    if (n == "negative") return [jsKw("exclusiveMaximum", jsNum("0"))];
    if (n == "negativeOrZero") return [jsKw("maximum", jsNum("0"))];
    if (n == "gt") return [jsKw("exclusiveMinimum", jsNum(first))];
    if (n == "lt") return [jsKw("exclusiveMaximum", jsNum(first))];
    if (n == "multipleOf") return [jsKw("multipleOf", jsNum(first))];
    if (n == "safeInt")
        return [
            jsKw("minimum", jsNum("-9007199254740991")),
            jsKw("maximum", jsNum("9007199254740991")),
        ];
    if (n == "float32")
        return [
            jsKw("minimum", "Json.Num(-3.4028234663852886e38)"),
            jsKw("maximum", "Json.Num(3.4028234663852886e38)"),
        ];
    if (n == "pattern") return [jsKw("pattern", jsStr(unquoted(first)))];
    if (n == "startsWith")
        return [jsKw("pattern", jsStr("^" + regexEscaped(unquoted(first))))];
    if (n == "endsWith")
        return [jsKw("pattern", jsStr(regexEscaped(unquoted(first)) + "$"))];
    if (n == "includes")
        return [jsKw("pattern", jsStr(regexEscaped(unquoted(first))))];
    if (n == "base64") return [jsKw("contentEncoding", jsStr("base64"))];
    if (n == "literal") {
        val value = if (first.startsWith("\""))
            jsStr(unquoted(first))
        else if (first == "true" || first == "false")
            "Json.Bool(" + first + ")"
        else
            jsNum(first);
        return [jsKw("const", value)];
    }
    if (n == "oneOf")
        return [
            jsKw(
                "enum",
                jsArr(unquoted(first).split(",").map({ o -> jsStr(o) })),
            ),
        ];
    val format = formatOf(n);
    if (format != "") return [jsKw("format", jsStr(format))];
    val pattern = patternOf(n);
    if (pattern != "") return [jsKw("pattern", jsStr(pattern))];
    if (schemaIsMarker(n) || n == "check" || n == "preprocess")
        return ["!#[" + n + "] has no JSON Schema keyword"];
    return none;
}

// The node of a type with no markers, as its members.
fn typeKeywords(t: string, owner: string) -> Array<string> {
    if (t == "string") return [jsKw("type", jsStr("string"))];
    if (t == "i32" || t == "i64") return [jsKw("type", jsStr("integer"))];
    if (t == "f64") return [jsKw("type", jsStr("number"))];
    if (t == "bool") return [jsKw("type", jsStr("boolean"))];
    val none: Array<string> = [];
    if (t == "Json") return none;
    if (t.startsWith("?"))
        return nullableKeywords(typeKeywords(t.slice(1, t.length()), owner));
    if (schemaIsDeclared(t)) return [jsKw("$ref", jsStr("#/$defs/" + t))];
    if (schemaIsUnion(t))
        return [
            jsKw(
                "anyOf",
                jsArr(
                    splitTop(t, "|").map(
                        { a -> jsObj(typeKeywords(a, owner)) },
                    ),
                ),
            ),
        ];
    if (schemaIsTuple(t)) {
        val items = schemaTupleItems(t);
        val count = [items.length].join("");
        return [
            jsKw("type", jsStr("array")),
            jsKw(
                "prefixItems",
                jsArr(items.map({ it -> jsObj(typeKeywords(it, owner)) })),
            ),
            jsKw("items", "Json.Bool(false)"),
            jsKw("minItems", jsNum(count)),
            jsKw("maxItems", jsNum(count)),
        ];
    }
    if (schemaIsDict(t)) {
        val kv = schemaArgs(t);
        val k = kv.slice(0, 1).join("");
        val v = kv.slice(1, 2).join("");
        val names = if (k == "i32")
            [
                jsKw(
                    "propertyNames",
                    jsObj([jsKw("pattern", jsStr("^-?[0-9]+$"))]),
                ),
            ]
        else if (schemaIsDeclared(k))
            [
                jsKw(
                    "propertyNames",
                    jsObj([jsKw("$ref", jsStr("#/$defs/" + k))]),
                ),
            ]
        else
            none;
        return [
            jsKw("type", jsStr("object")),
            jsKw("additionalProperties", jsObj(typeKeywords(v, owner))),
        ].append(names);
    }
    val inner = schemaInner(t);
    if (inner == "") return none;
    if (schemaIsSet(t))
        return [
            jsKw("type", jsStr("array")),
            jsKw("items", jsObj(typeKeywords(inner, owner))),
            jsKw("uniqueItems", "Json.Bool(true)"),
        ];
    return [
        jsKw("type", jsStr("array")),
        jsKw("items", jsObj(typeKeywords(inner, owner))),
    ];
}

// `?T`: a node that is a type alone takes `null` into its type; one with more
// to say is `anyOf` with `{"type": "null"}` (§ 8.3 Nullability).
fn nullableKeywords(members: Array<string>) -> Array<string> {
    if (members.length == 0) return members;
    val only = members.slice(0, 1).join("");
    val head = "#(\"type\", Json.Str(";
    if (members.length == 1 && only.startsWith(head)) {
        val name = only.slice(head.length(), only.length() - 2);
        return [jsKw("type", jsArr(["Json.Str(" + name + ")", jsStr("null")]))];
    }
    return [
        jsKw(
            "anyOf",
            jsArr([jsObj(members), jsObj([jsKw("type", jsStr("null"))])]),
        ),
    ];
}

// Every `#[validated]` type a type names, for its `$defs`.
fn referencedTypes(t: string) -> Array<string> {
    val none: Array<string> = [];
    if (schemaIsBuiltin(t)) return none;
    if (t.startsWith("?")) return referencedTypes(t.slice(1, t.length()));
    if (schemaIsDeclared(t)) return [t];
    if (schemaIsUnion(t))
        return splitTop(t, "|")
            .map({ a -> referencedTypes(a) })
            .fold(none, { acc, xs -> acc.append(xs) });
    if (schemaIsTuple(t))
        return schemaTupleItems(t)
            .map({ a -> referencedTypes(a) })
            .fold(none, { acc, xs -> acc.append(xs) });
    if (schemaIsDict(t))
        return schemaArgs(t)
            .map({ a -> referencedTypes(a) })
            .fold(none, { acc, xs -> acc.append(xs) });
    val inner = schemaInner(t);
    if (inner == "") return none;
    return referencedTypes(inner);
}

fn metaKeywords(annotations: Array<DeclAnnotation>) -> Array<string> {
    var out: Array<string> = [];
    annotations.forEach({ a ->
        val first = unquoted(a.args.slice(0, 1).join(""));
        if (a.name == "title") out.push(jsKw("title", jsStr(first)));
        if (a.name == "describe") out.push(jsKw("description", jsStr(first)));
        if (a.name == "example")
            out.push(jsKw("examples", jsArr([jsStr(first)])));
        if (a.name == "deprecated")
            out.push(jsKw("deprecated", "Json.Bool(true)"));
    });
    return out;
}

// LANGUAGE GAP: a decorator body whose lambda holds many locals overflows the
// comptime stack (`wasm3: [trap] stack overflow`), so the field's node is this
// helper's, not the record loop's.
//
// A record field's node: its type's keywords, its markers' (an `#[each]`
// marker's on the items), `required` of an `#[exhaustive]` dict, the `default`
// of an `#[orElse]`, `null` for a `?T` that is not `#[present]`, and its
// metadata; `"!" + why` when a marker has no keyword.
fn fieldNode(
    declared: string,
    annotations: Array<DeclAnnotation>,
    owner: string,
    isPresent: bool,
    hasDefault: bool,
    orElseLexeme: string,
    exhaustive: bool,
) -> string {
    val nodeType = if (declared.startsWith("?"))
        declared.slice(1, declared.length())
    else
        declared;
    val eachMarkers = annotations.filter({ a -> a.name == "each" });
    val itemType = if (schemaIsList(nodeType))
        schemaItemOf(nodeType)
    else if (schemaIsSet(nodeType))
        schemaArgs(nodeType).slice(0, 1).join("")
    else
        "";
    var keywords = typeKeywords(nodeType, owner);
    if (eachMarkers.length > 0 && itemType != "") {
        var items = typeKeywords(itemType, owner);
        eachMarkers.forEach({ a ->
            items = items.append(
                markerKeywords(unquoted(a.args.join("")), [], itemType),
            );
        });
        val itemMissing = items.filter({ k -> k.startsWith("!") });
        if (itemMissing.length > 0) return itemMissing.slice(0, 1).join("");
        keywords = keywords
            .filter({ k -> k.startsWith("#(\"items\"") == false })
            .append([jsKw("items", jsObj(items))]);
    }
    annotations.forEach({ a ->
        if (a.name != "each")
            keywords = keywords.append(
                markerKeywords(a.name, a.args, nodeType),
            );
    });
    val missing = keywords.filter({ k -> k.startsWith("!") });
    if (missing.length > 0) return missing.slice(0, 1).join("");
    if (exhaustive && schemaIsDict(nodeType))
        keywords = keywords.append(
            [
                jsKw(
                    "required",
                    "derived.textArray("
                        + schemaArgs(nodeType).slice(0, 1).join("")
                        + ".options())",
                ),
            ],
        );
    if (hasDefault)
        keywords = keywords.append(
            [jsKw("default", literalJson(orElseLexeme))],
        );
    val shaped = if (declared.startsWith("?") && isPresent == false)
        nullableKeywords(keywords)
    else
        keywords;
    return jsObj(shaped.append(metaKeywords(annotations)));
}

// The functions of a type's JSON Schema, from its node's text and the types it
// reaches.
fn schemaDocMembers(
    name: string,
    node: string,
    refs: Array<string>,
    annotations: Array<DeclAnnotation>,
) -> Array<string> {
    val ids = annotations
        .filter({ a -> a.name == "schemaId" })
        .map({ a -> unquoted(a.args.join("")) });
    val id = ids.join("");
    var steps: Array<string> = [];
    var i = 0;
    val unique = refs.filter({ r -> r != name });
    while (i < unique.length) {
        val r = unique.slice(i, i + 1).join("");
        steps.push(
            "    val __a"
                + [i + 1].join("")
                + " = "
                + r
                + ".__schemaDefs(__a"
                + [i].join("")
                + ");",
        );
        i = i + 1;
    }
    val stepText = if (steps.length > 0) steps.join("\n") + "\n" else "";
    return [
        "pub fn __schemaNode() -> Json {\n    return " + node + ";\n}",
        "pub fn __schemaDefs(acc: Array<#(string, Json)>) -> Array<#(string, Json)> {\n"
            + "    if (derived.hasDef(acc, \""
            + name
            + "\")) { return acc; }\n"
            + "    val __a0 = acc.append([#(\""
            + name
            + "\", "
            + name
            + ".__schemaNode())]);\n"
            + stepText
            + "    return __a"
            + [unique.length].join("")
            + ";\n}",
        "pub fn jsonSchema() -> string {\n    return derived.documentOf(\""
            + name
            + "\", "
            + jsText(id)
            + ", "
            + name
            + ".__schemaNode(), "
            + name
            + ".__schemaDefs([]));\n}",
    ];
}

fn schemaIsMarker(name: string) -> bool {
    return markerNames().indexOf(name) >= 0;
}

// An argument's lexeme without its quotes: `"status"` → `status`.
fn unquoted(l: string) -> string {
    if (l.startsWith("\"") && l.endsWith("\"") && l.length() >= 2)
        return l.slice(1, l.length() - 1);
    return l;
}

// The members every `#[validated]` type has from its `parseAt` (decision 327),
// and the free function `decode` hands `derived.decodeText`.
fn schemaCommonMembers(name: string) -> Array<string> {
    return [
        "pub fn parse(input: Json) -> @Result<"
            + name
            + ", ValidationReport> {\n    return try "
            + name
            + ".parseAt(input, \"\");\n}",
        "pub fn decode(text: string) -> @Result<"
            + name
            + ", ValidationReport> {\n    return try derived.decodeText(text, __parseAt"
            + name
            + ");\n}",
    ];
}

fn schemaCommonHelper(name: string) -> string {
    return "fn __parseAt"
        + name
        + schemaResult(name)
        + "    return try "
        + name
        + ".parseAt(input, at);\n}\n";
}

// `#[validated]` on an enum. Payload-less: the variant's NAME is the wire value
// (`"Tuna"`), anything else `invalidValue` with the options. With
// `#[tag("status")]`: an object whose member `status` names the variant, and
// whose other members are the variant's payload — a `#[validated]` record named
// after the enum and the variant, reached by `<Enum><Variant>.parseAt` and held
// as the variant's one field `value` (`Success(value: ReplySuccess)`). Not the
// variant's own name: a variant's constructor is a name of the module, and a
// record `Success` beside `Reply.Success` is constructed as the variant.
//
// LANGUAGE GAP: `Decl.variants` carries a variant's name and not its payload
// fields or its annotations (`language-gaps.md`), so neither form can tell from here
// whether a variant has a payload, nor read a marker on it: a payload-less
// enum whose variant carries fields, and a tagged one whose variant has no
// payload record, fail where the emitted code names them.
fn schemaEnum(
    name: string,
    variants: Array<string>,
    tag: string,
) -> Array<string> {
    val options = "[" + variants.map({ v -> "\"" + v + "\"" }).join(", ") + "]";
    val head = "pub fn parseAt" + schemaResult(name);
    val opts = "pub fn options() -> Array<string> {\n    return "
        + options
        + ";\n}";
    val last = variants.slice(variants.length - 1, variants.length).join("");
    if (tag == "") {
        val arms = variants
            .slice(0, variants.length - 1)
            .map({ v ->
                "    if (__name == \""
                    + v
                    + "\") return "
                    + name
                    + "."
                    + v
                    + ";";
            });
        return [
            "",
            head
                + "    val __name = try derived.variantName(input, at, "
                + options
                + ");\n"
                + arms.join("\n")
                + "\n    return "
                + name
                + "."
                + last
                + ";\n}",
            opts,
        ];
    }
    val dispatch = variants
        .slice(0, variants.length - 1)
        .map({ v ->
            "    if (__tag == \""
                + v
                + "\") return try __decode"
                + name
                + "_"
                + v
                + "(__rest, at);";
        });
    val payloads = variants.map({ v ->
        "fn __decode"
            + name
            + "_"
            + v
            + schemaResult(name)
            + "    val __v = try "
            + name
            + v
            + ".parseAt(input, at);\n    return "
            + name
            + "."
            + v
            + "(value: __v);\n}\n";
    });
    return [
        payloads.join(""),
        head
            + "    val __shape = derived.objectProblems(input, at);\n"
            + "    if (__shape.length > 0) { throw ValidationReport(violations: __shape); }\n"
            + "    val __tag = try derived.variantName(input.field(\""
            + tag
            + "\") ?? Json.Null, derived.memberPath(at, \""
            + tag
            + "\"), "
            + options
            + ");\n"
            + "    val __rest = derived.without(input, \""
            + tag
            + "\");\n"
            + dispatch.join("\n")
            + "\n    return try __decode"
            + name
            + "_"
            + last
            + "(__rest, at);\n}",
        opts,
    ];
}

fn isIntLexeme(l: string) -> bool {
    val digits = if (l.startsWith("-")) l.slice(1, l.length()) else l;
    if (digits == "") return false;
    return digits.split("").filter({ c -> "0123456789".indexOf(c) < 0 }).length
        == 0;
}

fn isNumberLexeme(l: string) -> bool {
    val body = if (l.startsWith("-")) l.slice(1, l.length()) else l;
    if (body == "") return false;
    val strange = body
        .split("")
        .filter({ c -> "0123456789.eE-+".indexOf(c) < 0 });
    return strange.length == 0 && "0123456789".indexOf(body.slice(0, 1)) >= 0;
}

fn transformNames() -> Array<string> {
    return ["trim", "lowercased", "uppercased", "normalized", "normalizedUrl"];
}

// What `#[coerce]` reads a field's text as (`derived.coerced`); `""` for a type
// it does not coerce. An `i64` beside `#[isoDatetime]` / `#[isoDatetimeOffset]`
// reads an RFC 3339 instant as epoch milliseconds (Zod's `z.coerce.date()`).
fn coerceHint(t: string, names: Array<string>) -> string {
    if (t == "string" || t == "i32" || t == "f64" || t == "bool") return t;
    if (t == "i64") {
        if (names.indexOf("isoDatetime") >= 0) return "isoUtc";
        if (names.indexOf("isoDatetimeOffset") >= 0) return "isoOffset";
        return "i64";
    }
    return "";
}

// How the form binder reads a field from text (`derived.formDocument`).
fn formHint(declared: string, names: Array<string>) -> string {
    if (names.indexOf("stringbool") >= 0) return "stringbool";
    if (declared.startsWith("?"))
        return "opt:"
            + formScalarHint(declared.slice(1, declared.length()), names);
    if (schemaIsList(declared))
        return "list:" + formScalarHint(schemaItemOf(declared), names);
    if (schemaIsSet(declared))
        return "list:"
            + formScalarHint(schemaArgs(declared).slice(0, 1).join(""), names);
    return formScalarHint(declared, names);
}

fn formScalarHint(t: string, names: Array<string>) -> string {
    val h = coerceHint(t, names);
    if (h == "") return "raw";
    return h;
}

// The expression a literal default or fallback is emitted as, for a field of
// type `t` (its `?` taken off; `declared` as written), or `"!" + why` when the
// lexeme is not a value of that type.
fn literalFor(l: string, t: string, declared: string) -> string {
    if (t == "string") {
        if (l.startsWith("\"") && l.endsWith("\"") && l.length() >= 2) return l;
        return "!the literal `" + l + "` is not a `string`";
    }
    if (t == "i32") {
        if (isIntLexeme(l)) return l;
        return "!the literal `" + l + "` is not an `i32`";
    }
    if (t == "i64") {
        if (isIntLexeme(l)) return "derived.widened(" + l + ".0)";
        return "!the literal `" + l + "` is not an `i64`";
    }
    if (t == "f64") {
        if (isNumberLexeme(l)) return asF64(l);
        return "!the literal `" + l + "` is not an `f64`";
    }
    if (t == "bool") {
        if (l == "true" || l == "false") return l;
        return "!the literal `" + l + "` is not a `bool`";
    }
    if (schemaIsDeclared(t)) {
        val variant = l.slice(1, l.length());
        if (l.startsWith(".") && schemaIsName(variant))
            return t + "." + variant;
        return "!a value of `"
            + t
            + "` is one of its variants, written `.Variant`, and this is `"
            + l
            + "`";
    }
    return "!a literal applies to `string`, `i32`, `i64`, `f64`, `bool` and enum fields, and this field is `"
        + declared
        + "`";
}

// What `#[validated]` adds to make the type its own schema (decisions 306,
// 327): element 0 the free functions its members call, element 1 a refusal
// (`""` for none), every other element one member, one `fn` each.
fn parsing(
    name: string,
    variants: Array<string>,
    fields: Array<Field>,
    annotations: Array<DeclAnnotation>,
) -> Array<string> {
    val tags = annotations.filter({ a -> a.name == "tag" });
    val tag = if (tags.length > 0)
        unquoted(tags.slice(0, 1).map({ a -> a.args.join("") }).join(""))
    else
        "";
    val isEnum = variants.length > 0;
    val enumNode = if (tag == "")
        jsObj(
            [
                jsKw("type", jsStr("string")),
                jsKw("enum", jsArr(variants.map({ v -> jsStr(v) }))),
            ].append(metaKeywords(annotations)),
        )
    else
        jsObj(
            [
                jsKw(
                    "oneOf",
                    jsArr(
                        variants.map({ v ->
                            "derived.withTag("
                                + name
                                + v
                                + ".__schemaNode(), "
                                + jsText(tag)
                                + ", "
                                + jsText(v)
                                + ")";
                        }),
                    ),
                ),
            ].append(metaKeywords(annotations)),
        );
    val enumRefs = if (tag == "") [] else variants.map({ v -> name + v });
    if (isEnum) {
        val parsed = schemaEnum(name, variants, tag);
        return [parsed.slice(0, 1).join("") + schemaCommonHelper(name), ""]
            .append(parsed.slice(1, parsed.length))
            .append(encEnumMembers(name, variants, tag))
            .append(schemaDocMembers(name, enumNode, enumRefs, annotations))
            .append(schemaCommonMembers(name));
    }
    val transparent = annotations.filter({ a ->
        a.name == "validated" && a.args.join("") == "transparent";
    }).length
        > 0;
    var problem = "";
    if (tag != "")
        problem = "#[tag] on `"
            + name
            + "`: a tag names the variant of an enum, and this type is a record";
    if (transparent && fields.length != 1)
        problem = "#[validated(transparent)] on `"
            + name
            + "`: a transparent type is written as its one field, and this type has "
            + [fields.length].join("");
    var decoders: Array<string> = [];
    var gathers: Array<string> = [];
    var args: Array<string> = [];
    var known: Array<string> = [];
    var helpers: Array<string> = [];
    var fallbacks: Array<string> = [];
    var rebuilt: Array<string> = [];
    var hints: Array<string> = [];
    var encMembers: Array<string> = [];
    var encRest = "";
    var properties: Array<string> = [];
    var requiredNames: Array<string> = [];
    var refs: Array<string> = [];
    var restNode = "";
    val strictSchema = annotations.filter(
        { a -> a.name == "jsonSchema" },
    ).length
        > 0;
    var marked = false;
    var rests = 0;
    fields.forEach({ f ->
        val declared = f.typeName;
        val names = f.annotations.map({ a -> a.name });
        val source = if (transparent)
            "input"
        else
            "(input.field(\"" + f.name + "\") ?? Json.Null)";
        val path = if (transparent)
            "at"
        else
            "derived.memberPath(at, \"" + f.name + "\")";
        val supported = schemaSupported(declared);
        val where = "#[validated] on field `"
            + f.name
            + "` of `"
            + name
            + "`: ";
        val bare = if (declared.startsWith("?"))
            declared.slice(1, declared.length())
        else
            declared;
        val isCoerced = names.indexOf("coerce") >= 0;
        val isStringBool = names.indexOf("stringbool") >= 0;
        val hint = coerceHint(bare, names);
        if (isCoerced && hint == "")
            problem = where
                + "#[coerce] reads text as `string`, `i32`, `i64`, `f64` or `bool` (or their `?T`), and this field is `"
                + declared
                + "`";
        if (isStringBool && declared != "bool")
            problem = where
                + "#[stringbool] reads text as a `bool`, and this field is `"
                + declared
                + "`";
        if (isStringBool && isCoerced)
            problem = where
                + "#[stringbool] already reads the field from text - drop #[coerce]";
        val pre = f.annotations
            .filter({ a -> a.name == "preprocess" })
            .map({ a -> a.args.join("") })
            .join("");
        val rawInput = if (pre == "") "input" else pre + "(input)";
        val rawSource = if (pre == "") source else pre + "(" + source + ")";
        val coercedInput = if (isCoerced && hint != "")
            "derived.coerced(" + rawInput + ", \"" + hint + "\")"
        else
            rawInput;
        val coercedSource = if (isCoerced && hint != "")
            "derived.coerced(" + rawSource + ", \"" + hint + "\")"
        else
            rawSource;
        val decoded = if (isStringBool)
            "derived.decodeStringBool(input, at)"
        else if (supported)
            schemaCall(declared, coercedInput, "at", name, f.name, "0")
        else
            "0";
        var call = if (isStringBool)
            "derived.decodeStringBool(" + source + ", " + path + ")"
        else if (supported)
            schemaCall(declared, coercedSource, path, name, f.name, "0")
        else
            "0";
        if (supported)
            helpers.push(
                schemaHelpers(declared, name, f.name, "0")
                    + encHelpers(declared, name, f.name, "0"),
            );
        val encoded = if (supported)
            encCall(declared, "v." + f.name, name, f.name, "0")
        else
            "Json.Null";
        if (names.indexOf("rest") >= 0)
            encRest = ".append(derived.membersOf(" + encoded + "))"
        else
            encMembers.push("#(\"" + f.name + "\", " + encoded + ")");
        if (supported == false)
            problem = "#[validated] on `"
                + name
                + "`: field `"
                + f.name
                + "` is `"
                + declared
                + "`, which this decorator does not decode - it reads string, i32, i64, f64, bool, Json, ?T, Array<T>, Set<T>, Dict<K, V> (K string, i32 or a #[validated] enum), tuples, unions and other #[validated] types";
        val exhaustive = names.indexOf("exhaustive") >= 0;
        val isRest = names.indexOf("rest") >= 0;
        val isPresent = names.indexOf("present") >= 0;
        val orElseLexeme = f.annotations
            .filter({ a -> a.name == "orElse" })
            .map({ a -> a.args.join("") })
            .join("");
        val orElseFn = unquoted(
            f.annotations
                .filter({ a -> a.name == "orElseOf" })
                .map({ a -> a.args.join("") })
                .join(""),
        );
        val fallbackLexeme = f.annotations
            .filter({ a -> a.name == "fallback" })
            .map({ a -> a.args.join("") })
            .join("");
        val fallbackFn = unquoted(
            f.annotations
                .filter({ a -> a.name == "fallbackOf" })
                .map({ a -> a.args.join("") })
                .join(""),
        );
        val ops = f.annotations
            .filter({ a -> transformNames().indexOf(a.name) >= 0 })
            .map({ a ->
                if (a.name == "normalized")
                    "normalized:" + unquoted(a.args.join(""))
                else
                    a.name;
            })
            .join("|");
        val eachOps = f.annotations
            .filter({ a ->
                a.name == "each"
                    && transformNames().indexOf(unquoted(a.args.join(""))) >= 0;
            })
            .map({ a -> unquoted(a.args.join("")) })
            .join("|");
        if (eachOps != "" && schemaIsList(declared) == false)
            problem = where
                + "#[each] applies a transform to every item of an `Array<T>`, and this field is `"
                + declared
                + "`";
        if (eachOps != "" && schemaIsList(declared)) {
            val eachName = "__each" + name + "_" + f.name;
            helpers.push(
                "fn "
                    + eachName
                    + schemaResult(declared)
                    + "    val __s = try "
                    + decoded
                    + ";\n    return derived.transformEach(__s, \""
                    + eachOps
                    + "\");\n}\n",
            );
            call = eachName + "(" + coercedSource + ", " + path + ")";
        }
        if (ops != "" && bare != "string")
            problem = where
                + "a transform rewrites text, and this field is `"
                + declared
                + "`";
        f.annotations.forEach({ a ->
            if (schemaIsMarker(a.name)) marked = true;
        });
        if (isPresent) {
            if (declared.startsWith("?") == false)
                problem = where
                    + "#[present] says the key may be left out, so the field is `?T`, and this one is `"
                    + declared
                    + "`";
            if (declared.startsWith("?"))
                call = "derived.presentOf(input, \""
                    + f.name
                    + "\", at, "
                    + schemaRef(bare, name, f.name, "0_0")
                    + ")";
        }
        if (isRest) {
            val kv = if (schemaIsDict(declared)) schemaArgs(declared) else [""];
            if (kv.slice(0, 1).join("") != "string")
                problem = where
                    + "#[rest] holds the members the type does not declare, so the field is `Dict<string, T>`, and this one is `"
                    + declared
                    + "`";
            rests = rests + 1;
            call = schemaCall(
                declared,
                "derived.restOf(input, [__KNOWN__])",
                "at",
                name,
                f.name,
                "0",
            );
        }
        // The wrappers, innermost first: the default an absent key takes, the
        // transforms (a default is transformed like an input — Zod's
        // `.prefault`), the fallback. Each is one emitted function over the
        // one inside it; the field calls the outermost.
        var inner = decoded;
        var outer = "";
        val orElse = if (orElseLexeme != "")
            literalFor(orElseLexeme, bare, declared)
        else if (orElseFn != "")
            orElseFn + "()"
        else
            "";
        if (orElse.startsWith("!"))
            problem = "#[orElse] on field `"
                + f.name
                + "` of `"
                + name
                + "`: "
                + orElse.slice(1, orElse.length());
        val hasOrElse = orElse != "" && orElse.startsWith("!") == false;
        if (hasOrElse && (isRest || isPresent))
            problem = where
                + "a default is what an absent key takes, and #[rest] / #[present] say what absence means already";
        if (hasOrElse) {
            val orElseName = "__orElse" + name + "_" + f.name;
            helpers.push(
                "fn "
                    + orElseName
                    + schemaResult(declared)
                    + "    if (derived.isNull(input)) return "
                    + orElse
                    + ";\n    return try "
                    + inner
                    + ";\n}\n",
            );
            inner = orElseName + "(input, at)";
            outer = orElseName;
        }
        if (ops != ""
            && bare == "string"
            && isRest == false
            && isPresent == false) {
            val transformName = "__transform" + name + "_" + f.name;
            val apply = if (declared.startsWith("?"))
                "derived.transformOptional"
            else
                "derived.transformText";
            helpers.push(
                "fn "
                    + transformName
                    + schemaResult(declared)
                    + "    val __s = try "
                    + inner
                    + ";\n    return "
                    + apply
                    + "(__s, \""
                    + ops
                    + "\");\n}\n",
            );
            inner = transformName + "(input, at)";
            outer = transformName;
        }
        val fallback = if (fallbackLexeme != "")
            literalFor(fallbackLexeme, bare, declared)
        else if (fallbackFn != "")
            fallbackFn + "()"
        else
            "";
        if (fallback.startsWith("!"))
            problem = "#[fallback] on field `"
                + f.name
                + "` of `"
                + name
                + "`: "
                + fallback.slice(1, fallback.length());
        if (fallback != "" && fallback.startsWith("!") == false) {
            val fallbackName = "__fallback" + name + "_" + f.name;
            helpers.push(
                "fn "
                    + fallbackName
                    + schemaResult(declared)
                    + "    val __r = "
                    + inner
                    + ";\n    if (derived.violationsOf(__r).length > 0) return "
                    + fallback
                    + ";\n    return try __r;\n}\n",
            );
            outer = fallbackName;
            fallbacks.push(
                f.name
                    + ": if (__bad.indexOf(\""
                    + f.name
                    + "\") >= 0) "
                    + fallback
                    + " else __v."
                    + f.name,
            );
        }
        if (fallback == "" || fallback.startsWith("!"))
            rebuilt.push(f.name + ": __v." + f.name)
        else
            rebuilt.push(
                fallbacks
                    .slice(fallbacks.length - 1, fallbacks.length)
                    .join(""),
            );
        if (outer != "") call = outer + "(" + source + ", " + path + ")";
        // The field's JSON Schema node.
        val nodeText = fieldNode(
            declared,
            f.annotations,
            name,
            isPresent,
            orElseLexeme != "" && orElse.startsWith("!") == false,
            orElseLexeme,
            exhaustive,
        );
        if (strictSchema && nodeText.startsWith("!"))
            problem = "#[jsonSchema] on `"
                + name
                + "`: field `"
                + f.name
                + "`: "
                + nodeText.slice(1, nodeText.length())
                + " - remove #[jsonSchema] or the marker";
        val node = if (nodeText.startsWith("!"))
            jsObj(metaKeywords(f.annotations))
        else
            nodeText;
        refs = refs.append(referencedTypes(declared));
        if (isRest)
            restNode = jsObj(
                typeKeywords(schemaArgs(declared).slice(1, 2).join(""), name),
            );
        if (isRest == false) properties.push(jsKw(f.name, node));
        val optionalKey = declared.startsWith("?")
            || isPresent
            || isRest
            || orElse != "";
        if (optionalKey == false) requiredNames.push(jsStr(f.name));
        val typeMessage = f.annotations
            .filter({ a -> a.name == "typeMessage" })
            .map({ a -> a.args.join("") })
            .join("");
        if (typeMessage != "")
            call = "derived.typeRestated("
                + call
                + ", "
                + path
                + ", "
                + typeMessage
                + ")";
        if (isRest == false)
            hints.push(
                "#(\"" + f.name + "\", \"" + formHint(declared, names) + "\")",
            );
        decoders.push("    val __r_" + f.name + " = " + call + ";");
        gathers.push(
            "    __vs = __vs.append(derived.violationsOf(__r_" + f.name + "));",
        );
        if (exhaustive) {
            val kv = if (schemaIsDict(declared)) schemaArgs(declared) else [""];
            val k = kv.slice(0, 1).join("");
            if (schemaIsDeclared(k))
                gathers.push(
                    "    __vs = __vs.append(derived.absentKeys("
                        + source
                        + ", "
                        + k
                        + ".options(), "
                        + path
                        + "));",
                )
            else
                problem = "#[exhaustive] on field `"
                    + f.name
                    + "` of `"
                    + name
                    + "`: it applies to `Dict<K, V>` whose key `K` is a #[validated] enum, and this field is `"
                    + declared
                    + "`";
        }
        args.push(f.name + ": try __r_" + f.name);
        if (isRest == false) known.push("\"" + f.name + "\"");
    });
    if (rests > 1)
        problem = "#[validated] on `"
            + name
            + "`: one #[rest] field holds every undeclared member, and this type has "
            + [rests].join("");
    val helperText = helpers.join("");
    val strip = annotations.filter({ a -> a.name == "stripUnknown" }).length
        > 0;
    if (strip && rests > 0)
        problem = "#[stripUnknown] on `"
            + name
            + "`: a #[rest] field keeps the undeclared members, so they cannot also be dropped";
    val undeclared = if (strip || rests > 0 || transparent)
        ""
    else
        "\n    __vs = __vs.append(derived.unknownKeys(input, ["
            + known.join(", ")
            + "], at, \""
            + name
            + "\"));";
    val onlyField = fields.slice(0, 1).map({ f -> f.name }).join("");
    val rooted = if (transparent)
        "derived.underField(at, \"" + onlyField + "\", "
    else
        "derived.under(at, ";
    // The record is rebuilt field by field, not `Name(..__v, …)`: inside a
    // member, commonJS emits the spread as a positional argument.
    // LANGUAGE GAP: `T(..v, f: x)` in a member added by `decl.addMember` is
    // `new T(v, x)` on commonJS.
    val checks = if (fallbacks.length > 0)
        "    val __bad = derived.failedFields(__v.validate());\n    val __w = "
            + name
            + "("
            + rebuilt.join(", ")
            + ");\n    val __checked = "
            + rooted
            + "__w.validate());\n    if (__checked.violations.length > 0) { throw __checked; }\n    return __w;\n"
    else
        "    val __checked = "
            + rooted
            + "__v.validate());\n    if (__checked.violations.length > 0) { throw __checked; }\n    return __v;\n";
    val shape = if (transparent)
        ""
    else
        "    val __shape = derived.objectProblems(input, at);\n    if (__shape.length > 0) { throw ValidationReport(violations: __shape); }\n";
    val parseAt = "pub fn parseAt(input: Json, at: string) -> @Result<"
        + name
        + ", ValidationReport> {\n"
        + shape
        + decoders.join("\n").replaceAll("__KNOWN__", known.join(", "))
        + "\n    var __vs: Array<Violation> = [];\n"
        + gathers.join("\n")
        + undeclared
        + "\n    if (__vs.length > 0) { throw ValidationReport(violations: __vs); }\n"
        + "    val __v = "
        + name
        + "("
        + args.join(", ")
        + ");\n"
        + checks
        + "}";
    val written = if (transparent)
        encMembers
            .slice(0, 1)
            .map({ m -> m.slice(m.indexOf(", ") + 2, m.length() - 1) })
            .join("")
    else
        "derived.objectOf([" + encMembers.join(", ") + "]" + encRest + ")";
    val json = "pub fn __json(v: "
        + name
        + ") -> Json {\n    return "
        + written
        + ";\n}";
    val encode = "pub fn encode(v: "
        + name
        + ") -> @Result<Json, ValidationReport> {\n    val __checked = v.validate();\n    if (__checked.violations.length > 0) { throw __checked; }\n    return "
        + name
        + ".__json(v);\n}";
    val formInput = if (transparent)
        "(derived.formDocument(pairs, ["
            + hints.join(", ")
            + "]).field(\""
            + onlyField
            + "\") ?? Json.Null)"
    else
        "derived.formDocument(pairs, [" + hints.join(", ") + "])";
    val bind = "pub fn bind(pairs: Array<#(string, string)>) -> @Result<"
        + name
        + ", ValidationReport> {\n    return try "
        + name
        + ".parseAt("
        + formInput
        + ", \"\");\n}";
    val closed = if (strip)
        []
    else if (rests > 0)
        [jsKw("additionalProperties", restNode)]
    else
        [jsKw("additionalProperties", "Json.Bool(false)")];
    val recordNode = if (transparent)
        properties
            .slice(0, 1)
            .map({ p -> p.slice(p.indexOf(", ") + 2, p.length() - 1) })
            .join("")
    else
        jsObj(
            [
                jsKw("type", jsStr("object")),
                jsKw("properties", jsObj(properties)),
                jsKw("required", jsArr(requiredNames)),
            ]
                .append(closed)
                .append(metaKeywords(annotations)),
        );
    return [
        helperText + schemaCommonHelper(name),
        problem,
        parseAt,
        json,
        encode,
        bind,
    ]
        .append(schemaDocMembers(name, recordNode, refs, annotations))
        .append(schemaCommonMembers(name));
}

// `#[tag("status")]` beside `#[validated]` on an enum: the member that names the
// variant. `#[validated]` reads it.
pub fn tag(comptime decl: @Decl, comptime member: string) {
    if (decl.kind != DeclKind.Type) decl.fail("#[tag] must annotate a type");
    val problem = textArgProblem("tag", "member name", member);
    if (problem != "") decl.fail(problem);
}

// `#[exhaustive]` on a `Dict<K, V>` field whose key is a `#[validated]` enum:
// every variant must be a key. `#[validated]` reads it.
pub fn exhaustive(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[exhaustive] must annotate a field");
}

// ── step 5: object policy ───────────────────────────────────────────────────
//
// What a record does with what it was not told about. `#[validated]` reads every
// one of these; each checks only its own placement here.

// `z.object` (strips): the undeclared members are dropped — the type says so.
// The default refuses them (decision 144).
pub fn stripUnknown(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Type)
        decl.fail("#[stripUnknown] must annotate a type");
}

// `z.looseObject` / `.catchall(T)`: a `Dict<string, T>` field holding every
// undeclared member, decoded as `T`, in document order.
pub fn rest(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field) decl.fail("#[rest] must annotate a field");
}

// `.exactOptional()`: on a `?T` field, the key may be left out; a key holding
// `null` is refused.
pub fn present(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[present] must annotate a field");
}

// `.default(v)`: an absent (or `null`) key takes the value, of the field's
// type — a literal, or an enum's variant by reference (`#[orElse(.Tuna)]`,
// decisions 280 (2), 281).
pub fn orElse<T>(comptime decl: @Decl<T>, comptime value: T) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[orElse] must annotate a field");
}

// `.default(fn)`: an absent key takes what the function answers, called per
// parse — the function itself, not its name (decision 281).
pub fn orElseOf<T>(comptime decl: @Decl<T>, comptime function: fn() -> T) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[orElseOf] must annotate a field");
}

// `.catch(v)`: a value that does not decode, or fails its checks, is replaced
// by the value — of the field's type, as `#[orElse]`'s — and no violation is
// recorded for it.
pub fn fallback<T>(comptime decl: @Decl<T>, comptime value: T) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[fallback] must annotate a field");
}

// `.catch(fn)`: the same, with what the function answers.
pub fn fallbackOf<T>(comptime decl: @Decl<T>, comptime function: fn() -> T) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[fallbackOf] must annotate a field");
}

// ── step 6: coercion and transforms ─────────────────────────────────────────

// `z.coerce.*`: the field reads text by its type (`derived.coerced`) — a
// number by std's numeral grammar, a `bool` by the stringbool set, a `string`
// from a number or a boolean; an `i64` beside `#[isoDatetime]` reads an
// instant as epoch milliseconds.
pub fn coerce(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[coerce] must annotate a field");
}

// `z.stringbool()`: a `bool` field read from the stringbool set's text.
pub fn stringbool(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[stringbool] must annotate a field");
}

// The transforms of a text field, applied in the order the field writes them,
// before its checks run.
pub fn trim(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field) decl.fail("#[trim] must annotate a field");
}

pub fn lowercased(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[lowercased] must annotate a field");
}

pub fn uppercased(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[uppercased] must annotate a field");
}

pub fn normalized(comptime decl: @Decl, comptime form: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[normalized] must annotate a field");
    if (form != "NFC" && form != "NFD" && form != "NFKC" && form != "NFKD")
        decl.fail("#[normalized]: the form is one of NFC, NFD, NFKC, NFKD");
}

pub fn normalizedUrl(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[normalizedUrl] must annotate a field");
}

// ── step 7: messages ────────────────────────────────────────────────────────

// `.min(8, "Too short!")`: the text the marker just before it reports instead
// of its template.
pub fn message(comptime decl: @Decl, comptime text: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[message] must annotate a field");
    val problem = textArgProblem("message", "text", text);
    if (problem != "") decl.fail(problem);
}

// `z.string("Not a string!")`: the text the field's `invalidType` reports.
pub fn typeMessage(comptime decl: @Decl, comptime text: string) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[typeMessage] must annotate a field");
    val problem = textArgProblem("typeMessage", "text", text);
    if (problem != "") decl.fail(problem);
}

// `{ abort: true }`: the field's checks run in the order written, and only the
// first that fails is reported.
pub fn stopOnFirst(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[stopOnFirst] must annotate a field");
}

// ── step 8: field markers that take a function or a marker ─────────────────

// `z.preprocess(f, …)`: the field's raw document value goes through `f` before
// it is decoded.
pub fn preprocess(comptime decl: @Decl, comptime f: fn(input: Json) -> Json) {
    if (decl.kind != DeclKind.Field)
        decl.fail("#[preprocess] must annotate a field");
}

// `.refine(rule)` on a field: `rule` answers whether the field's value is
// valid; a `false` is a violation coded `custom`. On a type, the form takes the
// rule, the field it reports at, a message and a code (decision 280) — typed
// decorator arguments, which `01-checker` step 24 brings.
pub fn check<T>(comptime decl: @Decl<T>, comptime rule: fn(v: T) -> bool) {
    if (decl.kind == DeclKind.Type)
        decl.fail(
            "#[check] on a type takes the rule, the field it reports at, a message and a code - typed decorator arguments (01-checker step 24), which are not in yet",
        );
    if (decl.kind != DeclKind.Field && decl.kind != DeclKind.Type)
        decl.fail("#[check] must annotate a field");
}

// `z.array(z.email())`: a marker applied to every item of an `Array<T>` or a
// `Set<T>`, each item's violation at its own path (`guests[1]`). One marker per
// `#[each]`, written again for the next; a marker that takes arguments waits on
// the variadic parameter (decision 267).
//
// LANGUAGE GAP: `Decorator` (decision 268) is an unknown type in a package
// module reached by `mod` (`unknown type 'Decorator'`), and a decorator's name
// is assignable to no other parameter type (`argument 1 must be unknown`), so
// the marker is named as text — `#[each("email")]` — until it is; a name that
// is no marker is refused by `#[validated]`.
pub fn each(comptime decl: @Decl, comptime marker: string) {
    if (decl.kind != DeclKind.Field) decl.fail("#[each] must annotate a field");
}

// ── step 9: metadata and the JSON Schema ────────────────────────────────────
//
// `.meta({ title, description, examples, deprecated })` on a type or a field:
// annotations of its JSON Schema node. `#[validated]` reads them.

pub fn title(comptime decl: @Decl, comptime text: string) {
    if (decl.kind != DeclKind.Type && decl.kind != DeclKind.Field)
        decl.fail("#[title] must annotate a type or a field");
    val problem = metaTextProblem("title", text);
    if (problem != "") decl.fail(problem);
}

pub fn describe(comptime decl: @Decl, comptime text: string) {
    if (decl.kind != DeclKind.Type && decl.kind != DeclKind.Field)
        decl.fail("#[describe] must annotate a type or a field");
    val problem = metaTextProblem("describe", text);
    if (problem != "") decl.fail(problem);
}

pub fn example(comptime decl: @Decl, comptime text: string) {
    if (decl.kind != DeclKind.Type && decl.kind != DeclKind.Field)
        decl.fail("#[example] must annotate a type or a field");
    val problem = metaTextProblem("example", text);
    if (problem != "") decl.fail(problem);
}

pub fn deprecated(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Type && decl.kind != DeclKind.Field)
        decl.fail("#[deprecated] must annotate a type or a field");
}

// The id a registry knows the type by — `schemaIdOf<TypeName>()`, what
// `spi.registerSchema` is handed; the type's name when it carries none.
pub fn schemaId(comptime decl: @Decl, comptime id: string) {
    if (decl.kind != DeclKind.Type)
        decl.fail("#[schemaId] must annotate a type");
    val problem = metaTextProblem("schemaId", id);
    if (problem != "") decl.fail(problem);
}

// `unrepresentable: "throw"`: every field of the type has a JSON Schema
// keyword for each of its markers, or the type is refused, naming the field.
pub fn jsonSchema(comptime decl: @Decl) {
    if (decl.kind != DeclKind.Type)
        decl.fail("#[jsonSchema] must annotate a type");
}

// Metadata text is written into emitted source: a `"` or a `\` would have to
// be escaped twice over, and is refused instead.
fn metaTextProblem(marker: string, text: string) -> string {
    if (text == "") return "#[" + marker + "]: the text may not be empty";
    if (text.indexOf("\"") >= 0 || text.indexOf("\\") >= 0)
        return "#["
            + marker
            + "]: the text may not contain a double quote or a backslash";
    return "";
}
