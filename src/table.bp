//// validation — the constraint table, and what crosses. Moved from rakun
//// front 14's validation member (decision 116 rule 5).
////
//// `T.constraints()` answers a JSON description of the record's
//// constraints. It is the ONE thing that is serialized for a consumer that is
//// not botopink; a consumer that IS botopink gets the module instead and runs
//// `t.validate()` itself, which is why this front is a boundary front
//// rather than a code generator.
////
//// THIS FILE IMPORTS ONLY std's `json` WRITER, AND SO DOES `report`. A client
//// bundle obtains the table without importing anything that reaches a socket
//// or the filesystem; a dependency on anything else here would be that import.
////
//// WHY A BLOB AND NOT JSON IN THE DECORATOR. `#[validated]` adds
//// `constraints()` as a call to `constraintTableJson(name, blob)`
//// rather than as a JSON string literal. A decorator body that wrote the JSON
//// itself would be writing a string literal INTO source — two levels of
//// escaping — and the grammar would then live in a comptime body no test can
//// call. Here the grammar is an ordinary function on both rows, and the
//// decorator only has to concatenate names. Front 72's condition blob is the
//// same shape for the same reason.
////
//// THE GRAMMAR. Records are separated by `;`, fields of a record by `|`:
////
////     <field>|<code>[|<arg>]*
////
//// Records arrive in declaration order, grouped by field, because the
//// decorator walks `decl.fields` and then each field's `annotations`. A
//// constraint argument carrying `;` or `|` is refused at compile time by the
//// decorator, so the grammar has no escape and needs none.

import {schemas.jsonText, schemas.refsPrefixed, schemas.refsRenamed};
import {json, json.Json} from "std";

pub fn splitBlob(blob: string) -> string[] {
    val none: string[] = [];
    if (blob == "") return none else return blob.split(";");
}

// The parameter names a code writes into the table, in argument order. A code
// with no parameters answers the empty list, and an unknown code is treated as
// having none — the decorator is what refuses an unknown marker, and it refuses
// it by never emitting a row for it.
pub fn paramNames(code: string) -> string[] {
    if (code == "sizeBetween") return ["min", "max"];
    if (code == "minValue") return ["min"];
    if (code == "maxValue") return ["max"];
    if (code == "pattern") return ["regex"];
    if (code == "constraint") return ["name"];
    if (code == "minLength") return ["min"];
    if (code == "maxLength") return ["max"];
    if (code == "length") return ["length"];
    if (code == "startsWith") return ["prefix"];
    if (code == "endsWith") return ["suffix"];
    if (code == "includes") return ["substring"];
    if (code == "uuidV") return ["version"];
    if (code == "urlHost") return ["hostname"];
    if (code == "urlProtocol") return ["protocol"];
    if (code == "jwtAlg") return ["alg"];
    if (code == "macDelimiter") return ["delimiter"];
    if (code == "hash") return ["algorithm"];
    if (code == "hashEnc") return ["algorithm", "encoding"];
    if (code == "isoTimePrecision") return ["precision"];
    if (code == "isoDatetimePrecision") return ["precision"];
    if (code == "gt") return ["bound"];
    if (code == "lt") return ["bound"];
    if (code == "multipleOf") return ["step"];
    if (code == "afterIso") return ["instant"];
    if (code == "beforeIso") return ["instant"];
    if (code == "literal") return ["expected"];
    if (code == "oneOf") return ["options"];
    val none: string[] = [];
    return none;
}

// `min`, `max`, `length`, `version`, `precision`, `bound` and `step` are numbers on
// the wire; every other parameter is a string.
pub fn paramIsNumber(name: string) -> bool {
    return name == "min"
        || name == "max"
        || name == "length"
        || name == "version"
        || name == "precision"
        || name == "bound"
        || name == "step";
}

pub fn renderParam(name: string, value: string) -> string {
    if (paramIsNumber(name)) return value else return json.quote(value);
}

pub fn constraintJson(parts: string[]) -> string {
    val code = parts.at(1) ?? "";
    val names = paramNames(code);
    var members: Array<#(string, string)> = [#("code", json.quote(code))];
    var j = 0;
    while (j < names.length) {
        val nm = names.at(j) ?? "";
        val pv = parts.at(j + 2) ?? "";
        members.push(#(nm, renderParam(nm, pv)));
        j = j + 1;
    }
    return json.object(members);
}

// `constraints` is the already-encoded, comma-joined list of one field's
// constraint objects.
pub fn fieldJson(name: string, constraints: string) -> string {
    return json.object(
        [
            #("name", json.quote(name)),
            #("constraints", ["[", constraints, "]"].join("")),
        ],
    );
}

// The whole table. Deterministic: one pass over the blob, no map, no sort, no
// clock — the same source produces byte-identical JSON on every rebuild and on
// both rows.
pub fn constraintTableJson(typeName: string, blob: string) -> string {
    val recs = splitBlob(blob);
    var fields = "";
    var current = "";
    var cons = "";
    var i = 0;
    while (i < recs.length) {
        val parts = (recs.at(i) ?? "").split("|");
        val fname = parts.at(0) ?? "";
        if (fname != current) {
            if (current != "") fields = fields + fieldJson(current, cons) + ",";
            current = fname;
            cons = "";
        }
        if (cons != "") cons = cons + ",";
        cons = cons + constraintJson(parts);
        i = i + 1;
    }
    if (current != "") fields = fields + fieldJson(current, cons);
    return json.object(
        [
            #("type", json.quote(typeName)),
            #("fields", ["[", fields, "]"].join("")),
        ],
    );
}

// ── step 9: JSON Schema dialects ────────────────────────────────────────────
//
// `jsonSchemaOf<TypeName>()` writes draft 2020-12; these rewrite such a
// document for a reader of another dialect (Zod's `target`). A text that is
// not a JSON document is answered unchanged.

fn parsedOr(doc: string) -> Json {
    return try json.decode(doc) catch Json.Null;
}

// Draft-07: `$schema` names draft-07, `$defs` is `definitions` (and every
// `$ref` into it), a tuple's `prefixItems` is `items` with `additionalItems:
// false`.
pub fn toDraft07(doc: string) -> string {
    val tree = parsedOr(doc);
    if (tree.isObject() == false) return doc;
    return jsonText(
        refsPrefixed(draft07Node(tree), "#/$defs/", "#/definitions/"),
    );
}

fn draft07Node(node: Json) -> Json {
    return case node {
        Arr(items) -> Json.Arr(items.map({ i -> draft07Node(i) }));
        Obj(members) -> Json.Obj(draft07Members(members));
        _ -> node;
    };
}

fn draft07Members(members: Array<#(string, Json)>) -> Array<#(string, Json)> {
    val tuple = members.filter({ m -> m[0] == "prefixItems" }).length > 0;
    var out: Array<#(string, Json)> = [];
    members.forEach({ m ->
        if (m[0] == "$schema")
            out.push(
                #(
                    "$schema",
                    Json.Str("http://json-schema.org/draft-07/schema#"),
                ),
            )
        else if (m[0] == "$defs")
            out.push(#("definitions", draft07Node(m[1])))
        else if (m[0] == "prefixItems")
            out.push(#("items", draft07Node(m[1])))
        else if (tuple && m[0] == "items")
            out.push(#("additionalItems", m[1]))
        else
            out.push(#(m[0], draft07Node(m[1])));
    });
    return out;
}

// OpenAPI 3.0's schema object: no `$schema`; a nullable type is the type with
// `nullable: true` (`["string", "null"]`, or `anyOf` with `{"type": "null"}`);
// `const` is a one-value `enum`; `$defs` are the components a `$ref` names
// (`#/components/schemas/<Name>`), left out of the node.
pub fn toOpenApi30(doc: string) -> string {
    val tree = parsedOr(doc);
    if (tree.isObject() == false) return doc;
    return jsonText(
        refsPrefixed(openApiNode(tree), "#/$defs/", "#/components/schemas/"),
    );
}

fn openApiNode(node: Json) -> Json {
    return case node {
        Arr(items) -> Json.Arr(items.map({ i -> openApiNode(i) }));
        Obj(members) -> Json.Obj(openApiMembers(members));
        _ -> node;
    };
}

fn isNullType(j: Json) -> bool {
    return j
        .members()
        .filter({ m -> m[0] == "type" && m[1].str() == "null" }).length
        > 0;
}

fn openApiMembers(members: Array<#(string, Json)>) -> Array<#(string, Json)> {
    var out: Array<#(string, Json)> = [];
    members.forEach({ m ->
        val k = m[0];
        val v = m[1];
        if (k == "$schema" || k == "$defs") out = out else if (k == "type"
            && v.items().length > 0) {
            val named = v.items().filter({ t -> t.str() != "null" });
            out.push(#("type", named.at(0) ?? Json.Str("string")));
            if (named.length < v.items().length)
                out.push(#("nullable", Json.Bool(true)));
        } else if (k == "anyOf"
            && v.items().filter({ a -> isNullType(a) }).length > 0) {
            val others = v.items().filter({ a -> isNullType(a) == false });
            if (others.length == 1)
                (others.at(0) ?? Json.Null)
                    .members()
                    .forEach({ o ->
                        out.push(#(o[0], openApiNode(o[1])));
                    })
            else
                out.push(#("anyOf", openApiNode(Json.Arr(others))));
            out.push(#("nullable", Json.Bool(true)));
        } else if (k == "const")
            out.push(#("enum", Json.Arr([v])))
        else
            out.push(#(k, openApiNode(v)));
    });
    return out;
}

// A registry's document with every `$ref` that names an id (not one inside
// the document, `#…`) made absolute: `base + id + ".json"` (Zod's `uri`).
pub fn withRefBase(doc: string, base: string) -> string {
    val tree = parsedOr(doc);
    if (tree.isObject() == false) return doc;
    return jsonText(absoluteRefs(tree, base));
}

fn absoluteRefs(node: Json, base: string) -> Json {
    return case node {
        Arr(items) -> Json.Arr(items.map({ i -> absoluteRefs(i, base) }));
        Obj(members) -> Json.Obj(members.map({ m -> absoluteMember(m, base) }));
        _ -> node;
    };
}

fn absoluteMember(m: #(string, Json), base: string) -> #(string, Json) {
    if (m[0] == "$ref"
        && m[1].str() != ""
        && m[1].str().startsWith("#") == false)
        return #(m[0], Json.Str(base + m[1].str() + ".json"));
    return #(m[0], absoluteRefs(m[1], base));
}
