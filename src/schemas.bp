//// validation — from untrusted data to a typed value.
////
//// `validate<TypeName>` checks a value that is ALREADY a record. This module is
//// the step before it: a `Json` document in, a typed value or a report out.
////
////     pub type Schema<T>(run: fn(input: Json, at: string) -> @Result<T, ValidationReport>)
////
//// A schema is a decoder and nothing else: a function from a document and the
//// path it sits at to a value or the violations that say why not. The
//// primitives below are the decoders of the language's own types; `#[schema]`
//// (`decorators.bp`) emits one for a record out of them, by name; `optionalOf`
//// and `decodeArrayOf` compose them.
////
//// EVERY VIOLATION, NOT THE FIRST. A decoder of several parts — a list, a
//// record — decodes every part and reports every part's violations, each at its
//// own path. It answers a value only when there are none. The emitted record
//// decoder has the same shape, which is what makes "bind everything, then ask
//// once" true of a document as it is of a form (`binding.bp`).
////
//// ABSENT IS ONE VALUE. A key that is missing and a key whose value is `null`
//// decode the same: `null` for a `?T`, a violation coded `required` for a `T`.
//// A document cannot say "explicitly null" to a reader that has one absent value.
////
//// A RESULT IS BUILT BY A FUNCTION, NEVER BY A LAMBDA. `Ok(…)` and `Error(…)`
//// are patterns, not constructors: a `@Result` comes out of a function whose
//// return is one, through `return` and `throw`. So every decoder here is a named
//// function, a `throw` is written at the top level of its body (one inside a
//// `case` arm does not become the function's `Error` on erlang —
//// `language-gaps.md`), and a lambda only ever CALLS a decoder.

import {report.Violation, report.ValidationReport, report.violation};
import {messages.Arg, messages.arg, messages.noArgs, messages.message, messages.builtInTemplate, messages.MessageSource, messages.useParseSource, messages.clearParseSource};
import {path.key, path.index};
import {formats.isIsoDatetime, formats.isIsoDatetimeOffset};
import {json, json.Json, collections.Dict, collections.Set, io.clock, unicode, unicode.NormalizationForm, url} from "std";

pub type Schema<T>(
    run: fn(input: Json, at: string) -> @Result<T, ValidationReport>,
) {
    // Zod's `.parse` and `.safeParse` at once: the `@Result` is the safe form,
    // and `try` in a fallible function is the throwing one.
    pub fn parse(self: Self<T>, input: Json) -> @Result<T, ValidationReport> {
        val decoder = self.run;
        return try decoder(input, "");
    }

    // The same, for a value that sits inside a larger document.
    pub fn parseAt(
        self: Self<T>,
        input: Json,
        at: string,
    ) -> @Result<T, ValidationReport> {
        val decoder = self.run;
        return try decoder(input, at);
    }

    // JSON text in. Text that is not a JSON document is ONE violation at the
    // root, coded `invalidJson`, with the reader's own reason.
    pub fn decode(self: Self<T>, text: string) -> @Result<T, ValidationReport> {
        return try decodeText(text, self.run);
    }

    // `.parse(x, { error })`: the same, its messages from `source` first and
    // the installed source after (`messages.useParseSource`); a field's own
    // `#[message]` / `#[typeMessage]` still wins.
    pub fn parseWith(
        self: Self<T>,
        input: Json,
        source: MessageSource,
    ) -> @Result<T, ValidationReport> {
        val decoder = self.run;
        val _in = useParseSource(source);
        val r = decoder(input, "");
        val _out = clearParseSource();
        return try r;
    }

    // Whether the document decodes — for a caller that wants the answer and
    // not the report.
    pub fn accepts(self: Self<T>, input: Json) -> bool {
        val decoder = self.run;
        return violationsOf(decoder(input, "")).length == 0;
    }

    pub fn optional(self: Self<T>) -> Schema<?T> {
        val decoder = self.run;
        return Schema(run: { input, at -> optionalOf(input, at, decoder) });
    }

    pub fn array(self: Self<T>) -> Schema<Array<T>> {
        val decoder = self.run;
        return Schema(run: { input, at -> decodeArrayOf(input, at, decoder) });
    }
}

// A schema from a decoder — what `schemaOf<TypeName>()` answers.
pub fn of<T>(
    run: fn(input: Json, at: string) -> @Result<T, ValidationReport>,
) -> Schema<T> {
    return Schema(run: run);
}

// Named `text`, not `string`: a function called `string` shadows the primitive
// type in every annotation of its module (`at: string` then reads as "the
// function"), and the checker reports the mismatch far from the cause.
pub fn text() -> Schema<string> {
    return Schema(run: { input, at -> decodeString(input, at) });
}

pub fn int() -> Schema<i32> {
    return Schema(run: { input, at -> decodeInt(input, at) });
}

pub fn long() -> Schema<i64> {
    return Schema(run: { input, at -> decodeLong(input, at) });
}

pub fn float() -> Schema<f64> {
    return Schema(run: { input, at -> decodeFloat(input, at) });
}

pub fn boolean() -> Schema<bool> {
    return Schema(run: { input, at -> decodeBool(input, at) });
}

pub fn anyJson() -> Schema<Json> {
    return Schema(run: { input, at -> decodeJson(input, at) });
}

// ── reading a document ──────────────────────────────────────────────────────

// What a value is, in the words a message uses.
pub fn kindOf(input: Json) -> string {
    return case input {
        Null -> "null";
        Bool(_) -> "a boolean";
        Num(_) -> "a number";
        Str(_) -> "text";
        Arr(_) -> "a list";
        Obj(_) -> "an object";
    };
}

pub fn isNull(input: Json) -> bool {
    return kindOf(input) == "null";
}

fn textOf(input: Json) -> string {
    return case input {
        Str(value) -> value;
        _ -> "";
    };
}

fn numberOf(input: Json) -> f64 {
    return case input {
        Num(value) -> value;
        _ -> 0.0;
    };
}

fn boolOf(input: Json) -> bool {
    return case input {
        Bool(value) -> value;
        _ -> false;
    };
}

// The rejected value as a violation carries it: text as it is, a number and a
// boolean rendered, anything larger by its kind. It reaches a log line, never a
// response (`report.bp` — `violationJson` does not write it).
pub fn shown(input: Json) -> string {
    val k = kindOf(input);
    if (k == "text") return textOf(input);
    if (k == "a number") return [numberOf(input)].join("");
    if (k == "a boolean") return [boolOf(input)].join("");
    return k;
}

// ── violations ──────────────────────────────────────────────────────────────

fn refused(
    at: string,
    code: string,
    value: string,
    params: Array<Arg>,
) -> ValidationReport {
    return ValidationReport(
        violations: [
            violation(
                at,
                code,
                message(code, builtInTemplate(code), at, value, params),
                value,
            ),
        ],
    );
}

fn missing(at: string) -> ValidationReport {
    return refused(at, "required", "", noArgs());
}

// `required` at `at` — what an emitted decoder throws for an absent value it
// tests itself (a union with no optional arm).
pub fn required(at: string) -> ValidationReport {
    return missing(at);
}

fn wrongType(at: string, expected: string, input: Json) -> ValidationReport {
    return refused(
        at,
        "invalidType",
        shown(input),
        [arg("expected", expected), arg("received", kindOf(input))],
    );
}

// The violations of a result: none for a value.
pub fn violationsOf<T>(r: @Result<T, ValidationReport>) -> Array<Violation> {
    val none: Array<Violation> = [];
    return case r {
        Ok(_) -> none;
        Error(report) -> report.violations;
    };
}

// A report whose violations sit under `at` — what `parse<TypeName>` does with
// the report `validate<TypeName>` answers for a record that is itself a member
// of a larger document: `street` becomes `address.street`.
pub fn under(at: string, report: ValidationReport) -> ValidationReport {
    if (at == "") return report;
    return ValidationReport(
        violations: report.violations.map({ v ->
            violation(nested(at, v.field), v.code, v.message, v.invalidValue);
        }),
    );
}

fn nested(at: string, field: string) -> string {
    if (field == "") return at;
    if (field.startsWith("[")) return [at, field].join("");
    return [at, ".", field].join("");
}

// ── the primitives ──────────────────────────────────────────────────────────

pub fn decodeString(
    input: Json,
    at: string,
) -> @Result<string, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "text") throw wrongType(at, "text", input);
    return textOf(input);
}

pub fn decodeBool(input: Json, at: string) -> @Result<bool, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "a boolean") throw wrongType(at, "true or false", input);
    return boolOf(input);
}

pub fn decodeFloat(input: Json, at: string) -> @Result<f64, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "a number") throw wrongType(at, "a number", input);
    return numberOf(input);
}

// The two conversions the language has no spelling for: an `f64` that is
// already known to be whole and in range, as the integer it is. Both targets
// are asked to convert, never to decide — `isWhole` and the range tests below
// are botopink.
#[@External.Node("Math.trunc($0)")]
#[@External.Erlang("trunc($0)")]
declare fn wholeI32(n: f64) -> i32;

#[@External.Node("Math.trunc($0)")]
#[@External.Erlang("trunc($0)")]
declare fn wholeI64(n: f64) -> i64;

#[@External.Node("(Number.isInteger($0))")]
#[@External.Erlang("(fun(__N) -> __N == trunc(__N) end)($0)")]
declare fn isWhole(n: f64) -> bool;

// An `i32`: a JSON number with no fraction, inside the range. `1.0` is whole;
// `1.5` and `3000000000` are a wrong type, not a value to round or wrap.
pub fn decodeInt(input: Json, at: string) -> @Result<i32, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "a number") throw wrongType(at, "a whole number", input);
    val n = numberOf(input);
    val fits = isWhole(n) && n <= 2147483647.0 && n >= -2147483648.0;
    if (fits == false) throw wrongType(at, "a whole number", input);
    return wholeI32(n);
}

// An `i64`: a JSON number is an `f64`, so what a document can say exactly is a
// whole number within ±(2^53 − 1). Beyond that the wire form is digit text,
// which is coercion's (`#[coerce]`), not this decoder's.
pub fn decodeLong(input: Json, at: string) -> @Result<i64, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "a number") throw wrongType(at, "a whole number", input);
    val n = numberOf(input);
    val fits = isWhole(n)
        && n <= 9007199254740991.0
        && n >= -9007199254740991.0;
    if (fits == false) throw wrongType(at, "a whole number", input);
    return wholeI64(n);
}

// A `Json` field takes the document as it is, absent included: `Json.Null` is
// a value of the type.
pub fn decodeJson(input: Json, at: string) -> @Result<Json, ValidationReport> {
    return input;
}

// ── composition ─────────────────────────────────────────────────────────────

fn present<T>(v: T) -> ?T {
    return v;
}

fn absent<T>() -> ?T {
    return null;
}

// `?T`: absent decodes to `null`; anything else is the inner decoder's.
pub fn optionalOf<T>(
    input: Json,
    at: string,
    inner: fn(input: Json, at: string) -> @Result<T, ValidationReport>,
) -> @Result<?T, ValidationReport> {
    if (isNull(input)) return absent();
    val v = try inner(input, at);
    return present(v);
}

// `Array<T>`: every item is decoded at `at[i]`, every item's violations are
// reported, and the list is answered only when there are none.
pub fn decodeArrayOf<T>(
    input: Json,
    at: string,
    item: fn(input: Json, at: string) -> @Result<T, ValidationReport>,
) -> @Result<Array<T>, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "a list") throw wrongType(at, "a list", input);
    val items = input.items();
    var out: Array<T> = [];
    var found: Array<Violation> = [];
    var i = 0;
    while (i < items.length) {
        val r = item(items.at(i) ?? Json.Null, index(at, i));
        found = found.append(violationsOf(r));
        out = case r {
            Ok(v) -> out.append([v]);
            Error(_) -> out;
        };
        i = i + 1;
    }
    if (found.length > 0) throw ValidationReport(violations: found);
    return out;
}

// ── what the emitted record decoder calls ───────────────────────────────────

// `path.key`, reachable through this module's namespace: the emitted decoder
// names one namespace, and this is the path of a record's member.
pub fn memberPath(at: string, name: string) -> string {
    return key(at, name);
}

// Why `input` cannot be read as a record: absent, or not an object. Empty when
// it can.
pub fn objectProblems(input: Json, at: string) -> Array<Violation> {
    val none: Array<Violation> = [];
    val k = kindOf(input);
    if (k == "an object") return none;
    if (k == "null") return missing(at).violations;
    return wrongType(at, "an object", input).violations;
}

// One violation per member of `input` that `known` does not name, in document
// order. A record refuses what it does not declare (decision 67): a key nobody
// reads is a typo, a stale client or an attempt, and none of the three is
// served by dropping it in silence.
pub fn unknownKeys(
    input: Json,
    known: Array<string>,
    at: string,
    typeName: string,
) -> Array<Violation> {
    val extra = input.members().filter({ m -> known.indexOf(m[0]) < 0 });
    return extra.map({ m ->
        val where = key(at, m[0]);
        violation(
            where,
            "unrecognizedKey",
            message(
                "unrecognizedKey",
                builtInTemplate("unrecognizedKey"),
                where,
                "",
                [arg("key", m[0]), arg("type", typeName)],
            ),
            "",
        );
    });
}

// JSON text through a decoder. The reader's reason is the message's
// `{reason}`; its byte offset is in it (`std/json` — "… at byte <n>").
pub fn decodeText<T>(
    text: string,
    run: fn(input: Json, at: string) -> @Result<T, ValidationReport>,
) -> @Result<T, ValidationReport> {
    val read = json.decode(text);
    val reason = case read {
        Ok(_) -> "";
        Error(why) -> why;
    };
    if (reason != "")
        throw refused("", "invalidJson", "", [arg("reason", reason)]);
    val document = try read catch Json.Null;
    return try run(document, "");
}

// ── step 4: enums, unions, tuples, dicts, sets ──────────────────────────────

// `path.index`, through this module's namespace: the path of a list's item.
pub fn indexPath(at: string, i: i32) -> string {
    return index(at, i);
}

// The variant a text names, for an enum decoded by name: absent is
// `required`, anything but text `invalidType`, a text no variant has
// `invalidValue` with the options in declaration order.
pub fn variantName(
    input: Json,
    at: string,
    options: Array<string>,
) -> @Result<string, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "text") throw wrongType(at, "text", input);
    val name = textOf(input);
    if (options.indexOf(name) < 0)
        throw refused(
            at,
            "invalidValue",
            name,
            [arg("options", options.join(", "))],
        );
    return name;
}

// A union none of whose arms accepted the value: ONE `invalidUnion`, its
// message naming each arm's first violation in the order the type writes the
// arms.
pub fn noArm(
    at: string,
    input: Json,
    arms: Array<Array<Violation>>,
) -> ValidationReport {
    val firsts = arms.map(
        { vs -> vs.map({ v -> v.message }).slice(0, 1).join("") },
    );
    return refused(
        at,
        "invalidUnion",
        shown(input),
        [arg("arms", firsts.join("; "))],
    );
}

// The items of a tuple: a list of exactly `n`. Absent is `required`; anything
// else — another kind, another length — is `invalidType`.
pub fn tupleItems(
    input: Json,
    at: string,
    n: i32,
) -> @Result<Array<Json>, ValidationReport> {
    val k = kindOf(input);
    val expected = ["a list of ", [n].join(""), " items"].join("");
    if (k == "null") throw missing(at);
    if (k != "a list") throw wrongType(at, expected, input);
    val items = input.items();
    if (items.length != n) throw wrongType(at, expected, input);
    return items;
}

pub fn itemOf(items: Array<Json>, i: i32) -> Json {
    return items.at(i) ?? Json.Null;
}

// `Dict<K, V>`: a JSON object, each member's key decoded by `key` (handed the
// key as text) and its value by `value`, both at `at.<key>`; every member's
// violations reported, the dict answered only when there are none. Member
// order is the document's.
pub fn decodeDictOf<K, V>(
    input: Json,
    at: string,
    keyOf: fn(input: Json, at: string) -> @Result<K, ValidationReport>,
    valueOf: fn(input: Json, at: string) -> @Result<V, ValidationReport>,
) -> @Result<Dict<K, V>, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "an object") throw wrongType(at, "an object", input);
    val members = input.members();
    var out: Array<#(K, V)> = [];
    var found: Array<Violation> = [];
    var i = 0;
    while (i < members.length) {
        val m = members.at(i) ?? #("", Json.Null);
        val where = key(at, m[0]);
        val rk = keyOf(Json.Str(m[0]), where);
        val rv = valueOf(m[1], where);
        found = found.append(violationsOf(rk)).append(violationsOf(rv));
        out = case rk {
            Ok(kv) -> case rv {
                Ok(vv) -> out.append([#(kv, vv)]);
                Error(_) -> out;
            };
            Error(_) -> out;
        };
        i = i + 1;
    }
    if (found.length > 0) throw ValidationReport(violations: found);
    return Dict.ofEntries(out);
}

// `#[exhaustive]`: one `required` per option the object does not carry, at
// `at.<option>`, in the options' order.
pub fn absentKeys(
    input: Json,
    options: Array<string>,
    at: string,
) -> Array<Violation> {
    val present = input.members().map({ m -> m[0] });
    val gone = options.filter({ o -> present.indexOf(o) < 0 });
    return gone
        .map({ o -> missing(key(at, o)).violations })
        .fold(noViolations(), { acc, vs -> acc.append(vs) });
}

fn noViolations() -> Array<Violation> {
    val none: Array<Violation> = [];
    return none;
}

// `Set<T>`: a JSON list whose items are decoded as a list's are; an item equal
// to an earlier one is `duplicate` at its own index — a set does not fold a
// repeated item away in silence.
pub fn decodeSetOf<T>(
    input: Json,
    at: string,
    item: fn(input: Json, at: string) -> @Result<T, ValidationReport>,
) -> @Result<Set<T>, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    if (k != "a list") throw wrongType(at, "a list", input);
    val items = input.items();
    var out: Array<T> = [];
    var found: Array<Violation> = [];
    var i = 0;
    while (i < items.length) {
        val where = index(at, i);
        val r = item(items.at(i) ?? Json.Null, where);
        found = case r {
            Ok(v) -> found.append(
                repeated(out, v, where, items.at(i) ?? Json.Null),
            );
            Error(report) -> found.append(report.violations);
        };
        out = case r {
            Ok(v) -> out.append([v]);
            Error(_) -> out;
        };
        i = i + 1;
    }
    if (found.length > 0) throw ValidationReport(violations: found);
    return Set.fromList(out);
}

fn repeated<T>(
    seen: Array<T>,
    v: T,
    at: string,
    input: Json,
) -> Array<Violation> {
    if (seen.indexOf(v) < 0) return noViolations();
    return refused(at, "duplicate", shown(input), noArgs()).violations;
}

// A dict key as an `i32`: the key is text, read by the integer grammar.
pub fn decodeIntKey(input: Json, at: string) -> @Result<i32, ValidationReport> {
    val text = textOf(input);
    val digits = text.parseInt();
    val ok = case digits {
        Ok(_) -> true;
        Error(_) -> false;
    };
    if (ok == false) throw wrongType(at, "a whole number", input);
    val n = try text.parseFloat() catch 0.0;
    val fits = n <= 2147483647.0 && n >= -2147483648.0;
    if (fits == false) throw wrongType(at, "a whole number", input);
    return wholeI32(n);
}

// `input` without its member `name` — the payload of a tagged enum, whose tag
// the enum's decoder has already read.
pub fn without(input: Json, name: string) -> Json {
    return Json.Obj(input.members().filter({ m -> m[0] != name }));
}

// ── step 5: object policy ───────────────────────────────────────────────────

// `#[present]` on a `?T` field (Zod's `.exactOptional()`): the key may be left
// out — `null` — but a key that is there and holds `null` is `invalidType`.
pub fn presentOf<T>(
    input: Json,
    name: string,
    at: string,
    inner: fn(input: Json, at: string) -> @Result<T, ValidationReport>,
) -> @Result<?T, ValidationReport> {
    val where = key(at, name);
    val keys = input.members().map({ m -> m[0] });
    if (keys.indexOf(name) < 0) return absent();
    val value = input.field(name) ?? Json.Null;
    if (isNull(value))
        throw wrongType(where, "a value, or no key at all", value);
    val v = try inner(value, where);
    return present(v);
}

// The members of `input` that `known` does not name, in document order — what
// a `#[rest]` field holds.
pub fn restOf(input: Json, known: Array<string>) -> Json {
    if (kindOf(input) != "an object") return Json.Obj([]);
    return Json.Obj(input.members().filter({ m -> known.indexOf(m[0]) < 0 }));
}

// An `i64` from a whole `f64` literal — the emitted default of an `i64` field
// (an integer literal does not widen to `i64`).
pub fn widened(n: f64) -> i64 {
    return wholeI64(n);
}

// The fields a report names, the paths' first segments under `at` removed —
// which of a record's `#[fallback]` fields failed their checks.
pub fn failedFields(report: ValidationReport) -> Array<string> {
    return report.violations.map({ v -> v.field });
}

// ── step 6: coercion, transforms, the form binder ───────────────────────────
//
// Coercion is the same on both targets (decision 183): a text is read by the
// type it is coerced to, and a text that type does not read STAYS TEXT, so the
// decoder refuses it as `invalidType` — never a zero. `bool` reads the
// stringbool set (`"false"` is `false`, not Zod's truthiness); a number reads
// std's numeral grammar (`String.parseInt` for an integer, `parseFloat` for an
// `f64`); `""` is absent.

fn truthyWords() -> Array<string> {
    return ["true", "1", "yes", "on", "y", "enabled"];
}

fn falsyWords() -> Array<string> {
    return ["false", "0", "no", "off", "n", "disabled"];
}

fn isIntegerNumeral(text: string) -> bool {
    return case text.parseInt() {
        Ok(_) -> true;
        Error(_) -> false;
    };
}

fn millisAsFloat(ms: i64) -> f64 {
    return try [ms].join("").parseFloat() catch 0.0;
}

// A text as the type `hint` reads it: `i32`, `i64`, `f64`, `bool`, `isoUtc` /
// `isoOffset` (an RFC 3339 instant as epoch milliseconds — `#[coerce]
// #[isoDatetime]` / `#[isoDatetimeOffset]` on an `i64`), `stringbool` and
// `string` (the text itself).
fn fromText(text: string, hint: string) -> Json {
    if (hint == "string" || hint == "stringbool") return Json.Str(text);
    if (text == "") return Json.Null;
    if (hint == "i32" || hint == "i64") {
        if (isIntegerNumeral(text) == false) return Json.Str(text);
        return case text.parseFloat() {
            Ok(n) -> Json.Num(n);
            Error(_) -> Json.Str(text);
        };
    }
    if (hint == "f64")
        return case text.parseFloat() {
            Ok(n) -> Json.Num(n);
            Error(_) -> Json.Str(text);
        }
    if (hint == "bool") {
        val word = text.toLower();
        if (truthyWords().indexOf(word) >= 0) return Json.Bool(true);
        if (falsyWords().indexOf(word) >= 0) return Json.Bool(false);
        return Json.Str(text);
    }
    if (hint == "isoUtc" || hint == "isoOffset") {
        val shaped = if (hint == "isoUtc")
            isIsoDatetime(text)
        else
            isIsoDatetimeOffset(text);
        if (shaped == false) return Json.Str(text);
        return case clock.parseIso8601(text) {
            Ok(ms) -> Json.Num(millisAsFloat(ms));
            Error(_) -> Json.Str(text);
        };
    }
    return Json.Str(text);
}

// `#[coerce]`: a document value read as `hint` says. A `string` field takes a
// number or a boolean rendered; every other type takes text by its grammar.
// `null` stays absent (Zod's `"null"` is not taken — decision 183).
pub fn coerced(input: Json, hint: string) -> Json {
    val k = kindOf(input);
    if (hint == "string") {
        if (k == "a number" || k == "a boolean") return Json.Str(shown(input));
        return input;
    }
    if (k != "text") return input;
    return fromText(textOf(input), hint);
}

// `#[stringbool]`: a text of the stringbool set, case-insensitive — `true 1
// yes on y enabled` / `false 0 no off n disabled`; anything else, a JSON
// boolean included, is `invalidType`.
pub fn decodeStringBool(
    input: Json,
    at: string,
) -> @Result<bool, ValidationReport> {
    val k = kindOf(input);
    if (k == "null") throw missing(at);
    val word = textOf(input).toLower();
    val known = k == "text"
        && (truthyWords().indexOf(word) >= 0
            || falsyWords().indexOf(word) >= 0);
    if (known == false)
        throw wrongType(
            at,
            "one of true, 1, yes, on, y, enabled, false, 0, no, off, n, disabled",
            input,
        );
    return truthyWords().indexOf(word) >= 0;
}

// The transforms of a text field, in the order the field writes them, applied
// by the decoder before the checks: `trim`, `lowercased`, `uppercased`,
// `normalized:<NFC|NFD|NFKC|NFKD>`, `normalizedUrl` (`url.serialize` of
// `url.parse`).
pub fn transformText(text: string, ops: string) -> string {
    return ops.split("|").fold(text, { acc, op -> transformOne(acc, op) });
}

fn transformOne(text: string, op: string) -> string {
    if (op == "trim") return text.trim();
    if (op == "lowercased") return text.toLower();
    if (op == "uppercased") return text.toUpper();
    if (op == "normalizedUrl") return url.serialize(url.parse(text));
    if (op == "normalized:NFD")
        return unicode.normalize(text, NormalizationForm.NFD);
    if (op == "normalized:NFKC")
        return unicode.normalize(text, NormalizationForm.NFKC);
    if (op == "normalized:NFKD")
        return unicode.normalize(text, NormalizationForm.NFKD);
    if (op == "normalized:NFC")
        return unicode.normalize(text, NormalizationForm.NFC);
    return text;
}

pub fn transformOptional(text: ?string, ops: string) -> ?string {
    if (text == null) return null;
    return transformText(text ?? "", ops);
}

// The form binder's document: form pairs (what `querystring.parse` and
// `encoding.formParse` answer) as the object `parse` reads, one member per
// declared field typed by its hint — `list:<hint>` for an `Array<T>` / `Set<T>`
// (every value of a repeated name, in order; none is `[]`), `opt:<hint>` for a
// `?T`, `raw` for a type a form cannot say (the text, refused by its decoder).
// A `bool` with no value is `false` (an unchecked checkbox sends nothing); a
// value-less member is left out, so absence is the decoder's; a name the type
// does not declare is a member, for the unknown-key rule.
pub fn formDocument(
    pairs: Array<#(string, string)>,
    hints: Array<#(string, string)>,
) -> Json {
    var members: Array<#(string, Json)> = [];
    var i = 0;
    while (i < hints.length) {
        val h = hints.at(i) ?? #("", "");
        val values = pairs.filter({ p -> p[0] == h[0] }).map({ p -> p[1] });
        val v = formValue(values, h[1]);
        members = case v {
            Null -> members;
            _ -> members.append([#(h[0], v)]);
        };
        i = i + 1;
    }
    val names = hints.map({ h -> h[0] });
    val extra = pairs
        .filter({ p -> names.indexOf(p[0]) < 0 })
        .map({ p -> #(p[0], Json.Str(p[1])) });
    return Json.Obj(members.append(extra));
}

fn formValue(values: Array<string>, hint: string) -> Json {
    if (hint.startsWith("list:")) {
        val item = hint.slice(5, hint.length());
        return Json.Arr(values.map({ v -> formScalar(v, item) }));
    }
    if (hint.startsWith("opt:")) {
        if (values.length == 0) return Json.Null;
        return formScalar(values.at(0) ?? "", hint.slice(4, hint.length()));
    }
    if (values.length == 0) {
        if (hint == "bool") return Json.Bool(false);
        if (hint == "stringbool") return Json.Str("false");
        return Json.Null;
    }
    return formScalar(values.at(0) ?? "", hint);
}

fn formScalar(text: string, hint: string) -> Json {
    if (hint == "raw") return Json.Str(text);
    return fromText(text, hint);
}

// ── step 7: messages ────────────────────────────────────────────────────────

// `#[typeMessage("…")]`: the `invalidType` a field's own value answers, under
// the field's text.
pub fn typeRestated<T>(
    r: @Result<T, ValidationReport>,
    at: string,
    text: string,
) -> @Result<T, ValidationReport> {
    val vs = violationsOf(r);
    if (vs.length == 0) return try r;
    throw ValidationReport(
        violations: vs.map({ v ->
            if (v.code == "invalidType" && v.field == at)
                violation(v.field, v.code, text, v.invalidValue)
            else
                v;
        }),
    );
}

// ── step 8: encoding ────────────────────────────────────────────────────────
//
// `encode<TypeName>` / `jsonOf<TypeName>` (`#[schema]`) write a value as the
// document its decoder reads: a number as a JSON number, a list as an array, a
// set as an array in its order, a dict as an object, a tuple as an array, a
// union as its arm, an enum as its variant's name. A member whose value is
// `null` is left out — absent and `null` decode the same.

// An integer as the `f64` a JSON number is — converting, never deciding.
#[@External.Node("($0)")]
#[@External.Erlang("float($0)")]
declare fn floatOfI32(n: i32) -> f64;

#[@External.Node("($0)")]
#[@External.Erlang("float($0)")]
declare fn floatOfI64(n: i64) -> f64;

pub fn encodeInt(n: i32) -> Json {
    return Json.Num(floatOfI32(n));
}

pub fn encodeLong(n: i64) -> Json {
    return Json.Num(floatOfI64(n));
}

pub fn encodeOptional<T>(value: ?T, item: fn(v: T) -> Json) -> Json {
    val v = value;
    if (v == null) return Json.Null;
    return item(v);
}

pub fn encodeArrayOf<T>(values: Array<T>, item: fn(v: T) -> Json) -> Json {
    return Json.Arr(values.map(item));
}

pub fn encodeSetOf<T>(values: Set<T>, item: fn(v: T) -> Json) -> Json {
    return Json.Arr(values.toList().map(item));
}

pub fn encodeDictOf<K, V>(
    values: Dict<K, V>,
    keyText: fn(k: K) -> string,
    item: fn(v: V) -> Json,
) -> Json {
    val none: Array<#(string, Json)> = [];
    return Json.Obj(
        values.fold(
            none,
            { acc, k, v -> acc.append([#(keyText(k), item(v))]) },
        ),
    );
}

// The text a key is written as: an `i32` key by its digits, an enum key by
// its variant's name (its encoding is that text).
pub fn intKeyText(k: i32) -> string {
    return [k].join("");
}

pub fn textOfJson(j: Json) -> string {
    return textOf(j);
}

// An object of `members`, those holding `null` left out.
pub fn objectOf(members: Array<#(string, Json)>) -> Json {
    return Json.Obj(members.filter({ m -> isNull(m[1]) == false }));
}

// The members of an encoded object — what a `#[rest]` field adds to its
// record's own.
pub fn membersOf(j: Json) -> Array<#(string, Json)> {
    return j.members();
}

// A tagged enum's variant: its payload's object with the tag member first.
pub fn tagged(payload: Json, tag: string, variant: string) -> Json {
    return Json.Obj([#(tag, Json.Str(variant))].append(payload.members()));
}

// `#[each(transform)]` on an `Array<string>`: the transforms over every item.
pub fn transformEach(items: Array<string>, ops: string) -> Array<string> {
    return items.map({ x -> transformText(x, ops) });
}

// ── step 9: the JSON Schema document ────────────────────────────────────────

pub fn hasDef(defs: Array<#(string, Json)>, name: string) -> bool {
    return defs.filter({ d -> d[0] == name }).length > 0;
}

pub fn textArray(texts: Array<string>) -> Json {
    return Json.Arr(texts.map({ t -> Json.Str(t) }));
}

// A tagged enum's variant: its payload record's node with the tag member — a
// `const` of the variant's name — first and required.
pub fn withTag(node: Json, tag: string, variant: string) -> Json {
    val tagNode = Json.Obj([#("const", Json.Str(variant))]);
    return Json.Obj(node.members().map({ m -> retagged(m, tag, tagNode) }));
}

fn retagged(m: #(string, Json), tag: string, tagNode: Json) -> #(string, Json) {
    if (m[0] == "properties")
        return #(m[0], Json.Obj([#(tag, tagNode)].append(m[1].members())));
    if (m[0] == "required")
        return #(m[0], Json.Arr([Json.Str(tag)].append(m[1].items())));
    return m;
}

// The document of the type `name`: its node with `$schema` first and `$defs`
// last — every type it reaches but itself — and every `$ref` to itself written
// `#`, the document's root (ZOD_DOCUMENTATION.md § 8.2, `cycles`).
pub fn documentOf(
    name: string,
    node: Json,
    defs: Array<#(string, Json)>,
) -> string {
    val own = "#/$defs/" + name;
    val others = defs
        .filter({ d -> d[0] != name })
        .map({ d ->
            #(d[0], refsRenamed(d[1], own, "#"));
        });
    val head: Array<#(string, Json)> = [
        #("$schema", Json.Str("https://json-schema.org/draft/2020-12/schema")),
    ];
    val body = refsRenamed(node, own, "#").members();
    val tail: Array<#(string, Json)> = if (others.length > 0)
        [#("$defs", Json.Obj(others))]
    else
        [];
    return jsonText(Json.Obj(head.append(body).append(tail)));
}

// `node` with every `"$ref": old` written `"$ref": new`.
pub fn refsRenamed(node: Json, old: string, new: string) -> Json {
    return case node {
        Arr(items) -> Json.Arr(items.map({ i -> refsRenamed(i, old, new) }));
        Obj(members) -> Json.Obj(
            members.map({ m -> memberRenamed(m, old, new) }),
        );
        _ -> node;
    };
}

fn memberRenamed(
    m: #(string, Json),
    old: string,
    new: string,
) -> #(string, Json) {
    if (m[0] == "$ref" && textOf(m[1]) == old) return #(m[0], Json.Str(new));
    return #(m[0], refsRenamed(m[1], old, new));
}

// ── writing JSON ────────────────────────────────────────────────────────────

// A document as JSON text: members in order, no whitespace, a number by
// `numberText`.
pub fn jsonText(j: Json) -> string {
    return case j {
        Null -> "null";
        Bool(value) -> if (value) "true" else "false";
        Num(value) -> numberText(value);
        Str(value) -> json.quote(value);
        Arr(items) -> json.array(items.map({ i -> jsonText(i) }));
        Obj(members) -> json.object(
            members.map({ m -> #(m[0], jsonText(m[1])) }),
        );
    };
}

// The shortest text that reads back as `n`, the same on both targets: a whole
// number within ±(2^53 − 1) by its digits, any other by the host's shortest
// round-trip rendering.
pub fn numberText(n: f64) -> string {
    val whole = isWhole(n)
        && n <= 9007199254740991.0
        && n >= -9007199254740991.0;
    if (whole) return [wholeI64(n)].join("");
    return [n].join("");
}

// `node` with every `"$ref"` that starts with `old` starting with `new`.
pub fn refsPrefixed(node: Json, old: string, new: string) -> Json {
    return case node {
        Arr(items) -> Json.Arr(items.map({ i -> refsPrefixed(i, old, new) }));
        Obj(members) -> Json.Obj(
            members.map({ m -> memberPrefixed(m, old, new) }),
        );
        _ -> node;
    };
}

fn memberPrefixed(
    m: #(string, Json),
    old: string,
    new: string,
) -> #(string, Json) {
    val text = textOf(m[1]);
    if (m[0] == "$ref" && text.startsWith(old))
        return #(m[0], Json.Str(new + text.slice(old.length(), text.length())));
    return #(m[0], refsPrefixed(m[1], old, new));
}
